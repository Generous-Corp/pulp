# Pulp clang-format config.
#
# LLVM-derived with a 100-column line limit. Picked LLVM over Google
# because LLVM's brace + initializer-list formatting is closest to what
# Pulp's core/ subsystems use; Google's per-line-pragma and short-block
# rules would force a noisy rewrite of files that have been stable for
# months.
#
# READ THIS BEFORE RUNNING clang-format ON A FILE YOU DID NOT CREATE.
#
# The tree does not round-trip under this config and never did: it was
# hand-formatted before the config existed and has never been bulk
# reformatted. Measured 2026-09-14 over the 4,415 committed C++ files
# under core/ test/ tools/cli/ examples/: clang-format 21 (Xcode, CLT and
# Homebrew llvm@21 — byte-identical to each other) reflows 3,743 files
# (84.8%), 432,490 lines; clang-format 19 differs from 21 on 2 files.
# So "my clang-format reflows lines I did not touch" is not a version
# mismatch and no other version fixes it. Existing debt is grandfathered:
# the only enforcement is the DIFF-SCOPED check below, run advisory by the
# pre-push hook, `tools/scripts/gates.sh`, and the `Format (changed lines)`
# workflow. A whole-file `clang-format -i` (or `pulp fmt` on an existing
# file) produces a large unrelated diff that no gate asked for and every
# reviewer has to wade through.
#
# The supported workflow is DIFF-SCOPED: format only the lines you
# changed, against a base ref, with
#
#   tools/scripts/format_changed.sh            # rewrite touched lines vs origin/main
#   tools/scripts/format_changed.sh --check    # report only, exit 1 on a diff
#
# which resolves a clang-format 21 from Homebrew llvm@21 / Xcode / CLT
# (no PATH setup needed), passes `--lines=` for each hunk, and formats a
# NEW file whole. `clang-format -i` / `pulp fmt` on a brand-new file is
# fine too — the file has no history to preserve.
#
# The 672 files (15%) that DO round-trip are the ones written to this
# config as-is, so the options below are deliberately unchanged: each
# candidate correction measured against the whole tree (AccessModifierOffset
# -4: 156 of those files newly reflow, 3 stop; AllowShortFunctionsOnASingleLine
# Inline: 121 newly reflow, 7 stop) trades the conformant minority for a
# smaller total line delta. Changing them is a tree-wide style decision.

BasedOnStyle: LLVM

# Pulp's house width.
ColumnLimit: 100

# 4-space indent matches the existing C++ surface.
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Allow tight braces for empty function bodies (lots of `= default` /
# `: base() {}` constructors); keep one line per statement otherwise.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Prefer C++17/20 alignment of consecutive assignments, fewer eye-jumps
# in long parameter / value tables.
AlignConsecutiveAssignments:
  Enabled: false
AlignTrailingComments: true

# Pointer / reference style: `T* p`, `T& r`. Right-most has been the
# convention since the first commits.
PointerAlignment: Left
ReferenceAlignment: Pointer

# Sort headers in groups: own header first, then <system>, then
# "third-party", then "pulp/*". clang-format's default IncludeBlocks
# behavior is fine for now; revisit if it diverges from observed
# patterns.
SortIncludes: CaseSensitive

# Don't reflow Markdown / docs comments that already wrap at custom
# column widths.
ReflowComments: false

# Spaces in modern C++ ranges + initializers.
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterCStyleCast: false

# C++20 `concept` and `requires` show up in the runtime/state layers.
Standard: c++20
