{
  "hooks": {
    "Setup": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-pulp-cli.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-claude-prefs.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-worktree-lineage.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/decisions-contract-pointer.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/claude_md_sync.py\"; py=\"$(command -v python3 2>/dev/null || true)\"; [ -f \"$f\" ] && [ -x \"$py\" ] && \"$py\" \"$f\" --hook-json || true; exit 0",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/docs-reminder.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/cli-plugin-sync.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/decisions-contract-hint.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] || exit 0; f=\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tool-registry-reminder.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
