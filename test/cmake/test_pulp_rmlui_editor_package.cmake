if(NOT DEFINED PULP_SOURCE_DIR OR NOT DEFINED FIXTURE_DIR)
    message(FATAL_ERROR "PULP_SOURCE_DIR and FIXTURE_DIR are required")
endif()
file(MAKE_DIRECTORY "${FIXTURE_DIR}/src/assets")
file(WRITE "${FIXTURE_DIR}/src/assets/editor.rml" "<rml><body><div id='gain'/></body></rml>\n")
file(WRITE "${FIXTURE_DIR}/src/assets/editor.rcss" "#gain { color: white; }\n")
file(WRITE "${FIXTURE_DIR}/src/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(RmlUiPackage CXX)
add_library(VellumRmlUi::Core INTERFACE IMPORTED)
add_library(VellumRmlUi::SoftRenderer INTERFACE IMPORTED)
add_library(VellumRmlUi::NativeHost INTERFACE IMPORTED)
add_library(VellumRmlUi::VellumRenderer INTERFACE IMPORTED)
set_target_properties(VellumRmlUi::VellumRenderer PROPERTIES
    INTERFACE_LINK_LIBRARIES "Skia::skia;Dawn::dawn")
add_library(pulp-vellum INTERFACE)
add_library(pulp::vellum ALIAS pulp-vellum)
include("@PULP_SOURCE_DIR@/integrations/pulp-vellum/cmake/PulpRmlUiEditorPackage.cmake")
pulp_add_rmlui_editor_package(test::rmlui
    DOCUMENT "@FIXTURE_DIR@/src/assets/editor.rml"
    STYLESHEET "@FIXTURE_DIR@/src/assets/editor.rcss"
    ASSET_DIRS "@FIXTURE_DIR@/src/assets")
get_target_property(_f test::rmlui PULP_EDITOR_FACTORY_FUNCTION)
if(NOT _f STREQUAL "pulp::vellum::rmlui::generated::test_rmlui")
    message(FATAL_ERROR "factory property was not generated: ${_f}")
endif()
get_target_property(_doc test::rmlui PULP_RMLUI_DOCUMENT)
if(NOT _doc STREQUAL "@FIXTURE_DIR@/src/assets/editor.rml")
    message(FATAL_ERROR "document property was not recorded: ${_doc}")
endif()
get_target_property(_links test::rmlui INTERFACE_LINK_LIBRARIES)
string(JOIN ";" _link_text ${_links})
if(NOT _link_text MATCHES "pulp::vellum")
    message(FATAL_ERROR "pulp Vellum bridge is missing: ${_link_text}")
endif()
if(_link_text MATCHES "VellumRenderer|Skia|Dawn")
    message(FATAL_ERROR "RmlUi package reaches a forbidden renderer: ${_link_text}")
endif()
file(READ "${CMAKE_CURRENT_BINARY_DIR}/pulp-vellum/rmlui-editor-packages/test_rmlui.hpp" _header)
if(NOT _header MATCHES "rmlui_editor.hpp")
    message(FATAL_ERROR "generated factory header does not include the native editor")
endif()
]=])
file(READ "${FIXTURE_DIR}/src/CMakeLists.txt" _fixture)
string(REPLACE "@PULP_SOURCE_DIR@" "${PULP_SOURCE_DIR}" _fixture "${_fixture}")
string(REPLACE "@FIXTURE_DIR@" "${FIXTURE_DIR}" _fixture "${_fixture}")
file(WRITE "${FIXTURE_DIR}/src/CMakeLists.txt" "${_fixture}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE_DIR}/src" -B "${FIXTURE_DIR}/build"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "RmlUi editor package configure failed:\n${_output}${_error}")
endif()
message(STATUS "RmlUi editor package configure, generation, and link-closure checks passed")

file(MAKE_DIRECTORY "${FIXTURE_DIR}/missing")
file(WRITE "${FIXTURE_DIR}/missing/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(RmlUiMissingAssets CXX)
include("@PULP_SOURCE_DIR@/integrations/pulp-vellum/cmake/PulpRmlUiEditorPackage.cmake")
pulp_add_rmlui_editor_package(rmlui DOCUMENT "@FIXTURE_DIR@/src/assets/missing.rml"
    STYLESHEET "@FIXTURE_DIR@/src/assets/editor.rcss")
]=])
file(READ "${FIXTURE_DIR}/missing/CMakeLists.txt" _missing)
string(REPLACE "@PULP_SOURCE_DIR@" "${PULP_SOURCE_DIR}" _missing "${_missing}")
string(REPLACE "@FIXTURE_DIR@" "${FIXTURE_DIR}" _missing "${_missing}")
file(WRITE "${FIXTURE_DIR}/missing/CMakeLists.txt" "${_missing}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE_DIR}/missing" -B "${FIXTURE_DIR}/missing-build"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
if(_result EQUAL 0)
    message(FATAL_ERROR "RmlUi helper accepted a missing document")
endif()
message(STATUS "RmlUi helper refuses missing assets")
