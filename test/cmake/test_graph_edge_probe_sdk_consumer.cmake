cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED PULP_BUILD_DIR OR NOT DEFINED PULP_SOURCE_DIR)
    message(FATAL_ERROR "PULP_BUILD_DIR and PULP_SOURCE_DIR are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run)
set(_root "${PULP_BUILD_DIR}/graph-edge-probe-${_run}")
set(_prefix "${_root}/prefix")
set(_source "${_root}/consumer")
set(_build "${_root}/consumer-build")
file(MAKE_DIRECTORY "${_source}" "${PULP_BUILD_DIR}/Testing/Temporary")
set(_receipt "${PULP_BUILD_DIR}/Testing/Temporary/graph-edge-probe-${_run}.log")
function(step label)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${_root}"
        RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 240)
    file(APPEND "${_receipt}" "${label} exit=${_code}\n${_out}\n${_err}\n")
    if(NOT label STREQUAL "install")
        message(STATUS "${label} exit=${_code}\n${_out}\n${_err}")
    endif()
    if(NOT "${_code}" STREQUAL "0")
        message(FATAL_ERROR "${label} failed: ${_err}; receipt=${_receipt}")
    endif()
endfunction()
step(install "${CMAKE_COMMAND}" --install "${PULP_BUILD_DIR}" --prefix "${_prefix}" --config "${PULP_PARENT_BUILD_TYPE}")
file(READ "${_prefix}/sdk-provenance.json" _provenance)
file(APPEND "${_receipt}" "SDK provenance: ${_provenance}\n")
foreach(_artifact bin/pulp-cpp bin/pulp-mcp lib/libpulp-host.a include/pulp/host/signal_graph_runtime.hpp)
    file(SHA256 "${_prefix}/${_artifact}" _sha)
    file(APPEND "${_receipt}" "installed ${_artifact} sha256=${_sha}\n")
endforeach()
foreach(_file CMakeLists.txt main.cpp)
    configure_file("${PULP_SOURCE_DIR}/examples/graph-edge-probe/${_file}" "${_source}/${_file}" COPYONLY)
endforeach()
set(_args -S "${_source}" -B "${_build}" -G Ninja
    "-DPulp_DIR=${_prefix}/lib/cmake/Pulp" "-DCMAKE_PREFIX_PATH=${_prefix}"
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON" "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF"
    "-DCMAKE_BUILD_TYPE=${PULP_PARENT_BUILD_TYPE}" "-DCMAKE_CXX_COMPILER=${PULP_PARENT_CXX_COMPILER}"
    "-DCMAKE_CXX_FLAGS=${PULP_PARENT_CXX_FLAGS}" "-DCMAKE_EXE_LINKER_FLAGS=${PULP_PARENT_EXE_LINKER_FLAGS}")
if(PULP_PARENT_BUILD_TYPE STREQUAL "Debug")
    list(APPEND _args -DPULP_ALLOW_DEBUG_SDK=ON)
endif()
if(PULP_PARENT_SANITIZER)
    list(APPEND _args "-DPULP_SANITIZER=${PULP_PARENT_SANITIZER}")
endif()
if(PULP_PARENT_OSX_ARCHITECTURES)
    list(APPEND _args "-DCMAKE_OSX_ARCHITECTURES=${PULP_PARENT_OSX_ARCHITECTURES}")
endif()
step(configure "${CMAKE_COMMAND}" ${_args})
step(build "${CMAKE_COMMAND}" -E env PULP_BUILD_JOBS=1 bash
    "${PULP_SOURCE_DIR}/tools/ci/governed-build.sh" "${CMAKE_COMMAND}" --build "${_build}")
step(consumer "${CMAKE_CTEST_COMMAND}" --test-dir "${_build}" --output-on-failure)
step(parity "${PULP_PYTHON}" "${PULP_SOURCE_DIR}/test/graph_edge_probe_sdk.py"
    --consumer "${_build}/pulp-graph-edge-probe" --cli "${_prefix}/bin/pulp-cpp"
    --mcp "${_prefix}/bin/pulp-mcp" --directory "${_root}/fixture")
message(STATUS "Installed SDK edge probe receipt: ${_receipt}")
