set(_links "@_pulp_state_direct_links_escaped@")
if(_links STREQUAL "")
    set(_links_list)
else()
    string(REPLACE "\\;" ";" _links_list "${_links}")
endif()
list(SORT _links_list)
set(_expected "pulp::events;pulp::runtime")
if(NOT _links_list STREQUAL _expected)
    message(FATAL_ERROR "pulp-state direct link closure drifted: [${_links_list}] expected [${_expected}]")
endif()
message(STATUS "pulp-state direct link closure: runtime + events")
