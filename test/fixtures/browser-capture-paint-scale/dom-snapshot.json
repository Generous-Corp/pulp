    "\n  /* Boxes whose border, radius or shadow sits under a scale. Chrome scales\n     those lengths with the box; the snapshot reports the box post-transform\n     and the lengths pre-transform. */\n  body { margin: 0; background: #111; }\n  #panel { position: relative; width: 600px; height: 300px; background: #222; }\n  .abs { position: absolute; }\n  /* A hairline scaled on one axis: a 4px box with a 1px border at 5% width. */\n  #hair { left: 20px; top: 20px; width: 4px; height: 72px; border: 1px solid #e04040;\n          transform: scaleX(0.05); transform-origin: 0 0; }\n  /* A fit-to-viewport wrapper at half size around a rounded, shadowed card. */\n  #shrink { left: 60px; top: 20px; width: 200px; height: 100px;\n            transform: scale(0.5); transform-origin: 0 0; }\n  #card { left: 0; top: 0; width: 160px; height: 80px; border: 4px solid #4a6fa5;\n          border-radius: 16px; box-shadow: 0 8px 16px rgba(0, 0, 0, .5); background: #2c3036; }\n  /* Two axes with a rounded corner: the borders scale per side, the radius\n     cannot. */\n  #squash { left: 180px; top: 20px; width: 80px; height: 40px; border: 2px solid #40a060;\n            border-radius: 8px; background: #2c3036;\n            transform: scale(0.5, 1.5); transform-origin: 0 0; }\n  /* Two axes with a hard shadow, which one offset per axis carries. */\n  #hard { left: 260px; top: 20px; width: 80px; height: 40px; background: #2c3036;\n          box-shadow: 4px 4px 0 #a0a040; transform: scale(2, 1); transform-origin: 0 0; }\n  /* Two axes with a soft shadow, which it does not. */\n  #soft { left: 260px; top: 120px; width: 80px; height: 40px; background: #2c3036;\n          box-shadow: 0 6px 12px rgba(0, 0, 0, .6); transform: scale(2, 1); transform-origin: 0 0; }\n  /* A skew leaves no side with one width. */\n  #skewed { left: 440px; top: 20px; width: 80px; height: 40px; border: 2px solid #a040a0;\n            transform: skewX(20deg); transform-origin: 0 0; }\n  /* The control: the same card with no transform anywhere above it. */\n  #plain { left: 20px; top: 180px; width: 160px; height: 80px; border: 4px solid #4a6fa5;\n           border-radius: 16px; box-shadow: 0 8px 16px rgba(0, 0, 0, .5); background: #2c3036; }\n",
    "\n",
    "id",
    "__pulp_browser_capture_motion__",
    "*,*::before,*::after{animation:none!important;transition:none!important;caret-color:transparent!important;scroll-behavior:auto!important}",
