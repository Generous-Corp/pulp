    "\n  body { margin: 0; background: #111; font-family: Helvetica, Arial, sans-serif; }\n  #panel { position:relative; width:400px; height:200px; background:#101418; }\n\n  <local-path> A string, on both pseudo-elements of one box. */\n  #label { position:absolute; left:16px; top:16px; width:200px; height:32px;\n           background:#22303c; }\n  #label::before { content:\"BEFORE\"; color:#ffd166; font-size:20px;\n                   position:absolute; left:8px; top:4px; }\n  #label::after  { content:\"AFT\"; color:#06d6a0; font-size:20px;\n                   position:absolute; right:8px; top:4px; }\n\n  <local-path> The decorative idiom: empty content, painted as a box. */\n  #dot { position:absolute; left:16px; top:64px; width:60px; height:32px;\n         background:#22303c; }\n  #dot::before { content:\"\"; position:absolute; left:8px; top:8px;\n                 width:16px; height:16px; border-radius:50%; background:#ef476f; }\n\n  <local-path> counter() and attr(), which Chrome resolves before the snapshot. */\n  #list { position:absolute; left:120px; top:64px; margin:0; padding:0;\n          list-style:none; counter-reset:n; }\n  #list li { counter-increment:n; position:relative; height:24px;\n             color:#8ecae6; font-size:16px; }\n  #list li::before { content:counter(n) \". \"; color:#f4a261; }\n\n  #tag { position:absolute; left:16px; top:120px; width:200px; height:32px;\n         background:#22303c; font-size:18px; }\n  #tag::after { content:attr(data-tag); color:#a8dadc;\n                position:absolute; left:8px; top:4px; }\n",
