    "#text",
    "\n  html, body { margin: 0; background: #000; }\n  #panel { position: relative; width: 400px; height: 200px; overflow: hidden;\n           background: #000; font: 700 30px/1 sans-serif; }\n  /* Three groups at opacity .5 over black. Every fill is opaque and flat, so\n     each region's expected colour is one value Chromium computed. */\n  .g { position: absolute; top: 15px; width: 110px; height: 110px; opacity: .5; }\n  #g1 { left: 10px; } #g2 { left: 145px; } #g3 { left: 280px; }\n  .sq { position: absolute; width: 40px; height: 40px; }\n  /* (i) two children that do not overlap: group and per-child alpha agree. */\n  #a { left: 10px; top: 10px; background: rgb(200, 200, 200); }\n  #b { left: 60px; top: 60px; background: rgb(0, 200, 255); }\n  /* (ii) a bordered button whose chip and label overlap its own fill. */\n  .btn { position: absolute; left: 5px; top: 5px; width: 100px; height: 100px;\n         box-sizing: border-box; background: rgb(200, 200, 200);\n         border: 4px solid rgb(255, 255, 255); color: rgb(255, 40, 40); }\n  .chip { left: 25px; top: 46px; width: 42px; height: 42px; background: rgb(255, 40, 40); }\n  .label { position: absolute; left: 10px; top: 8px; }\n  /* (iii) a group nested in a group: the inner pair composites at .5 of .5. */\n  .inner { position: absolute; inset: 0; opacity: .5; }\n  /* A canvas that Chromium paints after the in-flow band overlapping it. A\n     nested tree draws the canvas before that band, so the panel lowers flat. */\n  #bottom { position: absolute; left: 0; top: 140px; width: 400px; }\n  #pa { height: 60px; background: rgb(32, 32, 32); }\n  #cv { position: relative; display: block; }\n  #pb { height: 20px; margin-top: -40px; background: rgb(64, 64, 64); }\n",
