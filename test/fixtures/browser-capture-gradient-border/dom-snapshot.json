    "#text",
    "\n  /* A flat, mid-grey page, far from the gradient's dark stop, so the colour\n     under a translucent border says which end of the gradient Chrome placed\n     there: the 0.8 stop (dark) or the transparent end (page grey). */\n  body { margin: 0; background: #78828c; }\n  #panel { position: relative; width: 400px; height: 180px; }\n  .bar {\n    position: absolute; left: 0; width: 400px; height: 44px;\n    border-bottom: 1px solid rgba(255, 255, 255, .06);\n    background: linear-gradient(to bottom, rgba(10, 14, 20, .8), rgba(10, 14, 20, 0));\n  }\n  /* Initial values: background-origin padding-box, background-repeat repeat.\n     The gradient tile is the 44px padding box and repeats into the 1px\n     border strip, so the border row shows the tile's first (0.8) row. */\n  #padding { top: 0; }\n  /* The tile is the 45px border box: the border row shows the transparent\n     end. Any renderer that sizes gradients to the border box already agrees\n     here. */\n  #border { top: 60px; background-origin: border-box; }\n  /* The tile is the padding box and does not repeat, so the border strip\n     carries no gradient at all: only the page under the white hairline. */\n  #norepeat { top: 120px; background-repeat: no-repeat; }\n\n  /* The two bars as a dark plugin panel authors them: border-box sizing, a\n     header whose gradient runs away from its bottom border, and a toolbar\n     whose gradient runs away from its top border. Both wrap the gradient's\n     0.8 stop under the border; whether that reads lighter or darker than the\n     transparent end depends on the backdrop, so each sits on its own. */\n  .panel { position: relative; width: 400px; box-sizing: border-box; }\n  .panel div { box-sizing: border-box; position: absolute; left: 0; width: 400px; }\n  #page { height: 120px; background: #05070a; }\n  .header {\n    height: 44px;\n    border-bottom: 1px solid rgba(255, 255, 255, .06);\n    background: linear-gradient(to bottom, rgba(10, 14, 20, .8), rgba(10, 14, 20, 0));\n  }\n  #header { top: 0; }\n  #header-border-box { top: 60px; background-origin: border-box; }\n  #canvas { height: 160px; background: #1b232c; }\n  .toolbar {\n    height: 56px;\n    border-top: 1px solid rgba(255, 255, 255, .06);\n    background: linear-gradient(to top, rgba(10, 14, 20, .8), rgba(10, 14, 20, 0));\n  }\n  #toolbar { top: 10px; }\n  #toolbar-border-box { top: 90px; background-origin: border-box; }\n",
