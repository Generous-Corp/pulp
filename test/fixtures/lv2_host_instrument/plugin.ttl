@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .

<http://example.com/pulp/lv2-host-instrument#amount>
    a lv2:Parameter ;
    rdfs:label "Amount" ;
    rdfs:range atom:Float ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 20.0 .

<http://example.com/pulp/lv2-host-instrument>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Pulp LV2 Host Instrument" ;
    lv2:requiredFeature urid:map , opts:options , work:schedule ;
    lv2:optionalFeature bufsz:boundedBlockLength ;
    opts:supportedOption bufsz:maxBlockLength ;
    lv2:extensionData work:interface , state:interface ;
    patch:writable <http://example.com/pulp/lv2-host-instrument#amount> ;
    lv2:port [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 0 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position , patch:Message ;
        lv2:designation lv2:control ;
        rsz:minimumSize 16384 ;
        lv2:index 2 ; lv2:symbol "control" ; lv2:name "Control"
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 3 ; lv2:symbol "notify" ; lv2:name "Notify"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "free_wheel" ; lv2:name "Free Wheel" ;
        lv2:designation lv2:freeWheeling ; lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:InputPort , lv2:CVPort ;
        lv2:index 7 ; lv2:symbol "mod" ; lv2:name "Mod"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "seen_bpm" ; lv2:name "Seen BPM"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "seen_speed" ; lv2:name "Seen Speed"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "seen_bar_beat" ; lv2:name "Seen Bar Beat"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "seen_bar" ; lv2:name "Seen Bar"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "seen_beat_unit" ; lv2:name "Seen Beat Unit"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "seen_beats_per_bar" ; lv2:name "Seen Beats Per Bar"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 14 ; lv2:symbol "seen_max_block" ; lv2:name "Seen Max Block"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "seen_sample_rate" ; lv2:name "Seen Sample Rate"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "note_ons" ; lv2:name "Note Ons"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "worker_responses" ; lv2:name "Worker Responses"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "seen_free_wheel" ; lv2:name "Seen Free Wheel"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "seen_amount" ; lv2:name "Seen Amount"
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "time_messages" ; lv2:name "Time Messages"
    ] .
