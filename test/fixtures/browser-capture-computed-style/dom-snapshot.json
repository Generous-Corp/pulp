    "TITLE",
    "STYLE",
    "\n  :root {\n    --panel: #12161a;\n    --accent: #39ff6a;\n    --face: #1b2026;\n  }\n  body { margin: 0; background: #060809; font-family: \"SF Mono\", Menlo, monospace; }\n  .panel {\n    position: relative;\n    width: 520px;\n    margin: 40px;\n    padding: 28px;\n    display: flex;\n    gap: 34px;\n    border-radius: 18px;\n    background: linear-gradient(150deg,\n      color-mix(in oklab, var(--panel) 94%, white),\n      var(--panel));\n    box-shadow:\n      0 1px 0 color-mix(in oklab, white 22%, transparent) inset,\n      0 22px 44px color-mix(in oklab, black 62%, transparent);\n  }\n  .knob { display: flex; flex-direction: column; align-items: center; gap: 10px; }\n  .face {\n    width: 96px;\n    height: 96px;\n    border-radius: 50%;\n    border: 1px solid color-mix(in oklab, var(--accent) 26%, transparent);\n    background: radial-gradient(circle at 34% 28%,\n      color-mix(in oklab, var(--accent) 42%, white),\n      color-mix(in oklab, var(--face) 88%, black) 58%,\n      #0d1013 100%);\n    box-shadow:\n      0 2px 0 color-mix(in oklab, white 24%, transparent) inset,\n      0 -14px 22px color-mix(in oklab, black 48%, transparent) inset,\n      0 0 26px color-mix(in oklab, var(--accent) 30%, transparent);\n    filter: saturate(1.05);\n  }\n  .cap { color: color-mix(in oklab, var(--accent) 70%, white); font-size: 13px; letter-spacing: 1.4px; }\n",
