{
  "schema": "pulp.gpu-dpr-corpus.v1",
  "version": 1,
  "requested_dprs": [1, 1.5, 2, 3],
  "modes": ["exact", "configured_max", "adaptive_simulation"],
  "configured_max_dpr": 2,
  "adaptive_profile": {
    "id": "a4-latency-guard-simulation-v1",
    "shipping": false,
    "scale_ladder": [1, 1.5, 2, 3],
    "downshift_after_over_budget_frames": 5,
    "upshift_after_under_budget_frames": 120,
    "upshift_budget_fraction": 0.7
  },
  "trial_contract": {
    "warmups": 5,
    "measured_trials": 30,
    "fresh_process_first_frame_trials": 20,
    "required_trace_categories": ["render", "gpu", "text", "js", "layout"],
    "required_metrics": [
      "cpu_frame_time", "gpu_frame_time", "first_frame_time",
      "interaction_latency", "render_target_bytes", "resident_bytes",
      "upload_bytes"
    ],
    "fidelity_gates": [
      "content_floor_passed", "capture_similarity", "small_text_legible",
      "thin_strokes_preserved", "logical_input_correct"
    ]
  },
