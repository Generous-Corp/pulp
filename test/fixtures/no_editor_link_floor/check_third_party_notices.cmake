# Check the ThirdPartyNotices.json files pulp_add_plugin() put into the
# no-editor bundles and the full-editor control bundle.
#
#   -DNO_EDITOR=<sdk>=<json>[|...]  one per no-editor format bundle, with the
#                                   format SDK that bundle must name
#   -DCONTROL=<json>                the FULL_EDITOR control bundle
#   -DCONTROL_REQUIRES=<name>|...   notices the control must name
#   -DCONTROL_FORBIDS=<name>|...    notices the control must not name
#   -DCONTROL_MISSING_SDKS=<ns>|... namespaces the control must report under
#                                   sdks_without_manifest
#
# A no-editor bundle names no UI-stack dependency, and still names the audio
# path it does carry, so an empty or unreadable file cannot pass. The control
# must name the UI stack, so a check that sees no Skia anywhere is blind rather
# than the floor clean.

set(_failures "")

function(_notice_names out_var path)
    if(NOT EXISTS "${path}")
        set(_failures "${_failures}\n  ${path}: missing" PARENT_SCOPE)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    file(READ "${path}" _doc)
    string(JSON _schema ERROR_VARIABLE _err GET "${_doc}" schema)
    if(_err OR NOT _schema STREQUAL "pulp.third-party-notices.v1")
        set(_failures "${_failures}\n  ${path}: not a pulp.third-party-notices.v1 file" PARENT_SCOPE)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    set(_names "")
    string(JSON _count LENGTH "${_doc}" notices)
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _name GET "${_doc}" notices ${_i} name)
            string(JSON _text GET "${_doc}" notices ${_i} license_text)
            if(_text STREQUAL "")
                set(_failures "${_failures}\n  ${path}: ${_name} has no license text" PARENT_SCOPE)
            endif()
            list(APPEND _names "${_name}")
        endforeach()
    endif()
    set(${out_var} "${_names}" PARENT_SCOPE)
endfunction()

string(REPLACE "|" ";" _no_editor "${NO_EDITOR}")
if(NOT _no_editor)
    list(APPEND _failures "\n  no NO_EDITOR bundles were passed")
endif()
foreach(_pair IN LISTS _no_editor)
    string(FIND "${_pair}" "=" _eq)
    string(SUBSTRING "${_pair}" 0 ${_eq} _format_sdk)
    math(EXPR _path_at "${_eq} + 1")
    string(SUBSTRING "${_pair}" ${_path_at} -1 _path)
    _notice_names(_names "${_path}")
    # The UI stacks a project chooses with `pulp create --ui` arrive as SDK
    # namespaces; a no-editor bundle reaches none of them, with or without a
    # manifest. The control's NoticesUnclaimed shows this list is populated.
    if(EXISTS "${_path}")
        file(READ "${_path}" _doc)
        string(JSON _count LENGTH "${_doc}" sdks_without_manifest)
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _ns GET "${_doc}" sdks_without_manifest ${_i})
                if(_ns MATCHES "^(Vellum|VellumRmlUi|RmlUi)$")
                    string(APPEND _failures "\n  ${_path}: reaches the ${_ns} SDK")
                endif()
            endforeach()
        endif()
        string(JSON _count LENGTH "${_doc}" sdks)
        if(_count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _sdk GET "${_doc}" sdks ${_i} name)
                if(_sdk MATCHES "^(Vellum|VellumRmlUi|RmlUi)$")
                    string(APPEND _failures "\n  ${_path}: lists notices from the ${_sdk} SDK")
                endif()
            endforeach()
        endif()
    endif()
    foreach(_forbidden Skia Dawn ICU RmlUi Yoga SDL3 SheenBidi)
        if(_forbidden IN_LIST _names)
            string(APPEND _failures "\n  ${_path}: names ${_forbidden}: ${_names}")
        endif()
    endforeach()
    foreach(_required "${_format_sdk}" "Mbed TLS")
        if(NOT _required IN_LIST _names)
            string(APPEND _failures "\n  ${_path}: does not name ${_required}: ${_names}")
        endif()
    endforeach()
endforeach()

string(REPLACE "|" ";" _control_requires "${CONTROL_REQUIRES}")
_notice_names(_control_names "${CONTROL}")
foreach(_required IN LISTS _control_requires)
    if(NOT _required IN_LIST _control_names)
        string(APPEND _failures "\n  ${CONTROL}: control does not name ${_required}: ${_control_names}")
    endif()
endforeach()
string(REPLACE "|" ";" _control_forbids "${CONTROL_FORBIDS}")
foreach(_forbidden IN LISTS _control_forbids)
    if(_forbidden IN_LIST _control_names)
        string(APPEND _failures "\n  ${CONTROL}: control names ${_forbidden}, whose feature is off")
    endif()
endforeach()
if(EXISTS "${CONTROL}")
    file(READ "${CONTROL}" _control_doc)
    set(_control_missing "")
    string(JSON _count LENGTH "${_control_doc}" sdks_without_manifest)
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _ns GET "${_control_doc}" sdks_without_manifest ${_i})
            list(APPEND _control_missing "${_ns}")
        endforeach()
    endif()
    string(REPLACE "|" ";" _expected_missing "${CONTROL_MISSING_SDKS}")
    foreach(_ns IN LISTS _expected_missing)
        if(NOT _ns IN_LIST _control_missing)
            string(APPEND _failures "\n  ${CONTROL}: sdks_without_manifest lacks ${_ns}: ${_control_missing}")
        endif()
    endforeach()
endif()
string(REGEX REPLACE "\\.json$" ".txt" _control_txt "${CONTROL}")
if(EXISTS "${_control_txt}")
    file(READ "${_control_txt}" _txt)
    foreach(_required IN LISTS _control_requires)
        string(FIND "${_txt}" "${_required}" _at)
        if(_at LESS 0)
            string(APPEND _failures "\n  ${_control_txt}: does not mention ${_required}")
        endif()
    endforeach()
else()
    string(APPEND _failures "\n  ${_control_txt}: missing")
endif()

if(_failures)
    message(FATAL_ERROR "third-party notices check failed:${_failures}")
endif()
message(STATUS "third-party notices: ${_no_editor} name no UI stack; control names ${_control_requires}")
