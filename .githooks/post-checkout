#!/bin/sh
# Trust this checkout's own .mise.toml when a worktree (or clone) is created.
#
# mise refuses an untrusted config, so in a fresh worktree every command that
# reaches python3 through the mise shim (gates.sh, the pre-push hook) fails.
# git runs this hook in the new working tree with the null sha as $1 and 1 as
# $3 when it checks a branch out for the first time. Exactly one file is
# trusted: mise's trusted_config_paths are prefixes, so trusting a parent
# directory would trust every repository under it, and a .mise.toml can run
# code. Never fails the checkout.
null_sha=0000000000000000000000000000000000000000
[ "${1:-}" = "$null_sha" ] && [ "${3:-}" = 1 ] || exit 0
config="$PWD/.mise.toml"
[ -f "$config" ] || exit 0
command -v mise >/dev/null 2>&1 || exit 0
mise trust --quiet "$config" >/dev/null 2>&1 \
  || echo "post-checkout: could not trust $config; run: mise trust $config" >&2
exit 0
