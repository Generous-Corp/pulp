{
  "schema": "pulp.gpu-dpr-corpus.v1",
  "version": 1,
  "requested_dprs": [1, 1.5, 2, 3],
  "modes": ["exact", "configured_max", "adaptive_simulation"],
  "configured_max_dpr": 2,
  "v2_protocol": {
    "id": "a4-dpr-experiment-v2",
    "status": "blocked-product-policy",
    "product_policy": null,
    "seed_encoding": "utf8-length-prefixed-u64be-v1",
    "prng": "sha256-counter-mode-u64be-v1",
    "bootstrap": {
      "method": "paired-percentile-bootstrap-v1",
      "resamples": 10000,
      "confidence_interval": 0.95,
      "sample_unit": "aligned-trial-p95",
      "percentile_method": "nearest-rank"
    },
    "repeat_scope": "all-84-cells",
    "daw_agreement": "terminal-verdict-gates-and-identity",
    "terminal_publication": "protected-pulp-main-with-green-required-checks"
  },
  "adaptive_profile": {
    "id": "a4-latency-guard-simulation-v1",
    "shipping": false,
    "scale_ladder": [1, 1.5, 2, 3],
    "downshift_after_over_budget_frames": 5,
    "upshift_after_under_budget_frames": 120,
    "upshift_budget_fraction": 0.7
  },
  "trial_contract": {
    "warmups": 5,
    "measured_trials": 30,
    "fresh_process_first_frame_trials": 20,
    "frames_per_warm_measured_trial": 240,
    "workload_sequence_id": "a4-steady-state-workload-v1",
    "timer_noise_p95_ns": null,
    "memory_sampler_resolution_bytes": null,
    "capture_similarity_minimum": 0.99,
    "small_text_luminance_stddev_minimum": 1.0,
    "thin_stroke_coverage_minimum": 0.001,
    "gpu_timer_calibration_trials": 5,
    "gpu_timer_extra_work_multiplier": 8,
    "required_trace_categories": ["render", "gpu", "text", "js", "layout"],
    "required_metrics": [
      "cpu_frame_time", "gpu_frame_time", "first_frame_time",
      "interaction_latency", "render_target_bytes", "resident_bytes",
      "upload_bytes"
    ],
    "fidelity_gates": [
      "content_floor_passed", "capture_similarity", "small_text_legible",
      "thin_strokes_preserved", "logical_input_correct"
    ]
  },
  "scenarios": [
