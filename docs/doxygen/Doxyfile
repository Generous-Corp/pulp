# Pulp API Reference — Doxygen Configuration
# Generates HTML documentation from public headers only.

PROJECT_NAME           = "Pulp"
PROJECT_BRIEF          = "Cross-platform audio plugin framework"
# Overridden at build time: tools/build-api-docs.sh streams this file through
# stdin and appends the SDK version, so the literal below is only a fallback
# for a bare `doxygen Doxyfile` run.
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = ../../build/api-docs

# Source paths — public headers only
#
# INPUT tracks the installed public header surface, so a core/* directory that
# is absent here is absent because it is not installed, not by oversight. The
# SDK header subsystem list in tools/cmake/PulpInstallRules.cmake is the
# authority, and tools/scripts/doxygen_installed_header_check.py enforces
# file-granular parity in both directions: documenting a header that is not
# installed fails that check just as omitting an installed one does.
#
# core/scene/include is the one core module this leaves out. It backs the
# pulp-scene static library and the scene3d command-line tools, and installs
# neither its target nor its headers, so it is not part of the SDK surface
# this reference documents.
INPUT                  = ../../core/audio/include \
                         ../../core/canvas/include \
                         ../../core/events/include \
                         ../../core/format/include \
                         ../../core/gpu_audio/include \
                         ../../core/graph/include \
                         ../../core/host/include \
                         ../../core/interchange/include \
                         ../../core/midi/include \
                         ../../core/music/include \
                         ../../core/osc/include \
                         ../../core/native-components/include \
                         ../../core/platform/include \
                         ../../core/playback/include \
                         ../../core/project_package/include \
                         ../../core/render/include \
                         ../../core/runtime/include \
                         ../../core/sequence/include \
                         ../../core/signal/include \
                         ../../core/state/include \
                         ../../core/dawproject/include \
                         ../../core/dsl/include \
                         ../../core/smf/include \
                         ../../core/timebase/include \
                         ../../core/timeline/include \
                         ../../core/timeline_agent_view/include \
                         ../../core/timeline_editor/include \
                         ../../core/timeline_view/include \
                         ../../core/view/include \
                         ../../tools/audio/analysis/include \
                         ../../inspect/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.inc *.hpp.in

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO

# Documentation style
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
INLINE_INHERITED_MEMB  = YES

# Output format
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
HTML_COLORSTYLE        = DARK

# Navigation
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES

# Diagrams
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = PULP_HAS_SDL3 \
                         __APPLE__

# Warnings
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Don't document internal namespaces
EXCLUDE_PATTERNS       = */src/* */detail/*
