{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielraffel/pulp/docs/status/consumption-profiles.schema.json",
  "title": "Pulp consumption profiles",
  "description": "Per-installed-target measurement of what a consumer of one Pulp target has to take: the targets its link interface reaches, the third-party and system dependencies that land on its link line, and the public header surface it offers in exchange. Generated by tools/scripts/consumption_census.py from a configured CMake build tree; never hand-edited.",
  "type": "object",
  "required": [
    "schema",
    "generated_by",
    "derivation",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 1
    },
    "generated_by": {
      "const": "tools/scripts/consumption_census.py"
    },
    "derivation": {
      "type": "object",
      "description": "How the numbers were obtained, and what they cannot say.",
      "required": [
        "method",
        "input",
        "build_time_derived",
        "closure_definition",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "build_time_derived": {
          "const": true,
          "description": "The census is measured from a configured build tree. A static reading of the CMakeLists files would be an approximation, and this field exists so that a future approximation cannot be published under the same name."
        },
        "closure_definition": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "description": "One entry per measured consumption profile, keyed by platform. A platform Pulp has not measured is absent rather than guessed at, and the drift gate skips on a host whose key is missing.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "key",
          "system_name",
          "system_processor",
          "features",
          "build_scope",
          "summary",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+-[a-z0-9_]+$"
          },
          "system_name": {
            "type": "string"
          },
          "system_processor": {
            "type": "string"
          },
          "features": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "ON",
                "OFF"
              ]
            },
            "description": "Switches that change which targets exist or what they link. A build tree that disagrees here is measuring a different SDK, so the drift gate skips rather than compares."
          },
          "build_scope": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "ON",
                "OFF"
              ]
            },
            "description": "Switches that decide which consumers the tree builds. Recorded for provenance and deliberately not compared: examples and tests depend on the SDK, never the reverse, so they cannot change a closure."
          },
          "summary": {
            "type": "object",
            "required": [
              "installed_target_count",
              "ranked_by_closure"
            ],
            "additionalProperties": false,
            "properties": {
              "installed_target_count": {
                "type": "integer",
                "minimum": 1
              },
              "ranked_by_closure": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "exported_as",
                    "closure_node_count",
                    "public_header_count"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "exported_as": {
                      "type": "string",
                      "pattern": "^Pulp::"
                    },
                    "closure_node_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "public_header_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "targets": {
            "type": "object",
            "description": "Keyed by exported name without the Pulp:: namespace.",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "target",
                "exported_as",
                "type",
                "source_dir",
                "closure",
                "external_dependencies",
                "public_headers",
                "direct_dependencies"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "exported_as": {
                  "type": "string",
                  "pattern": "^Pulp::"
                },
                "type": {
                  "type": "string"
                },
                "source_dir": {
                  "type": "string",
                  "description": "Repository-relative directory that defines the target, empty for a target defined outside the source tree. Absolute paths are machine-specific and are never recorded."
                },
                "closure": {
                  "type": "object",
                  "required": [
                    "node_count",
                    "pulp_targets",
                    "third_party_targets"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "node_count": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Every node reachable through the link interface, the target itself included."
                    },
                    "pulp_targets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "third_party_targets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "external_dependencies": {
                  "type": "object",
                  "description": "Everything on the consumer's link line that is not Pulp's own code.",
                  "required": [
                    "count",
                    "third_party_targets",
                    "prebuilt_archives",
                    "imported_targets",
                    "frameworks",
                    "system_libraries"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "third_party_targets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "prebuilt_archives": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Archive file names only. The paths they came from belong to one machine."
                    },
                    "imported_targets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "frameworks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "system_libraries": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "public_headers": {
                  "type": "object",
                  "required": [
                    "count",
                    "roots",
                    "generated_include_roots"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "roots": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "generated_include_roots": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Exported include roots that live under the build directory (generated or fetched headers). Counted rather than named: the build directory's name is a local choice."
                    }
                  }
                },
                "direct_dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "link_probe": {
            "type": "object",
            "description": "Host measurements from linking a trivial consumer of each target against an installed SDK. Wall-clock and byte counts move with the machine, the toolchain and the disk cache, so the drift gate deliberately does not compare this block: a CI difference here would say nothing about the SDK.",
            "required": [
              "status",
              "targets"
            ],
            "additionalProperties": true,
            "properties": {
              "status": {
                "enum": [
                  "measured"
                ]
              },
              "measured_on": {
                "type": "object"
              },
              "sdk_prefix_build_type": {
                "type": "string"
              },
              "configure_seconds_all_targets": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "type": "string"
              },
              "targets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "link-failed"
                      ]
                    },
                    "link_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "binary_bytes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "link_line_archives": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "link_line_archive_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "link_line_frameworks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "link_line": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
