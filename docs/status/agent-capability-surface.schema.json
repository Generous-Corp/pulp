{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielraffel/pulp/docs/status/agent-capability-surface.schema.json",
  "title": "Pulp agent capability public surface ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "inventory_version",
    "fingerprint_algorithm",
    "coverage_state",
    "roots",
    "counts",
    "headers",
    "tombstones"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "agent-capability-surface.schema.json" },
    "schema": { "type": "string", "const": "pulp.agent-capability-surface.v1" },
    "inventory_version": { "type": "integer", "minimum": 1 },
    "fingerprint_algorithm": { "type": "string", "const": "sha256-file-bytes" },
    "coverage_state": { "type": "string", "enum": ["partial", "complete"] },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "source", "install_prefix"],
        "properties": {
          "domain": {
            "type": "string",
            "enum": ["audio", "midi", "music", "sequence", "signal", "timebase"]
          },
          "source": { "type": "string", "minLength": 1 },
          "install_prefix": { "type": "string", "pattern": "^pulp/" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_headers",
        "reviewed_headers",
        "legacy_unreviewed_headers",
        "unsupported_headers",
        "by_disposition",
        "by_domain"
      ],
      "properties": {
        "public_headers": { "type": "integer" },
        "reviewed_headers": { "type": "integer" },
        "legacy_unreviewed_headers": { "type": "integer" },
        "unsupported_headers": { "type": "integer" },
        "by_disposition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer" }
        },
        "by_domain": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "enum": ["audio", "midi", "music", "sequence", "signal", "timebase"]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "public_headers",
              "reviewed_headers",
              "legacy_unreviewed_headers",
              "unsupported_headers"
            ],
            "properties": {
              "public_headers": { "type": "integer" },
              "reviewed_headers": { "type": "integer" },
              "legacy_unreviewed_headers": { "type": "integer" },
              "unsupported_headers": { "type": "integer" }
            }
          }
        }
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "source",
          "fingerprint",
          "include",
          "disposition",
          "capability_keys",
          "rationale"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": ["audio", "midi", "music", "sequence", "signal", "timebase"]
          },
          "source": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "include": { "type": "string", "pattern": "^pulp/" },
          "disposition": {
            "type": "string",
            "enum": [
              "capability_entrypoint",
              "capability_support",
              "infrastructure",
              "legacy_unreviewed",
              "unsupported_capability"
            ]
          },
          "capability_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 20 }
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "include",
          "last_fingerprint",
          "removed_in_inventory_version",
          "reason"
        ],
        "properties": {
          "include": { "type": "string", "pattern": "^pulp/" },
          "last_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "removed_in_inventory_version": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
