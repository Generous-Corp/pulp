{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielraffel/pulp/docs/status/agent-capabilities.schema.json",
  "title": "Pulp installed agent capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_minor",
    "manifest_revision",
    "required_features",
    "coverage",
    "capabilities",
    "tombstones",
    "counts",
    "compatibility"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "agent-capabilities.schema.json" },
    "schema": { "type": "string", "const": "pulp.agent-capabilities.v1" },
    "schema_minor": { "type": "integer" },
    "manifest_revision": { "type": "integer" },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "absence_semantics",
        "surface_schema",
        "surface_inventory_version",
        "public_headers",
        "reviewed_headers",
        "legacy_unreviewed_headers",
        "unsupported_headers",
        "domains"
      ],
      "properties": {
        "state": { "type": "string", "enum": ["partial", "complete"] },
        "absence_semantics": { "type": "string", "const": "unknown" },
        "surface_schema": {
          "type": "string",
          "const": "pulp.agent-capability-surface.v1"
        },
        "surface_inventory_version": { "type": "integer" },
        "public_headers": { "type": "integer" },
        "reviewed_headers": { "type": "integer" },
        "legacy_unreviewed_headers": { "type": "integer" },
        "unsupported_headers": { "type": "integer" },
        "domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "public_headers",
              "reviewed_headers",
              "legacy_unreviewed_headers",
              "unsupported_headers",
              "capabilities"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": ["partial", "complete", "not_inventoried"]
              },
              "public_headers": { "type": "integer" },
              "reviewed_headers": { "type": "integer" },
              "legacy_unreviewed_headers": { "type": "integer" },
              "unsupported_headers": { "type": "integer" },
              "capabilities": { "type": "integer" }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "domain",
          "summary",
          "contract_version",
          "contract_digest",
          "status",
          "evolution",
          "rt_class",
          "lifecycle",
          "state_model",
          "seed_model",
          "input_domain",
          "output_domain",
          "units",
          "latency",
          "tail",
          "scheduling",
          "bindings"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "enum": ["audio", "midi", "music", "offline", "sequence", "signal", "timebase"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "contract_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer" },
              "minor": { "type": "integer" }
            }
          },
          "contract_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["stable", "usable", "experimental", "partial", "unsupported"]
          },
          "evolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": {
              "state": { "type": "string", "enum": ["active", "deprecated"] },
              "deprecated_in": {
                "type": "object",
                "additionalProperties": false,
                "required": ["major", "minor"],
                "properties": {
                  "major": { "type": "integer" },
                  "minor": { "type": "integer" }
                }
              },
              "replacement_key": { "type": ["string", "null"] }
            }
          },
          "rt_class": {
            "type": "string",
            "enum": ["audio", "control", "any", "offline", "mixed"]
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["construction", "prepare", "process", "reset", "release"],
            "properties": {
              "construction": { "type": "string", "minLength": 1 },
              "prepare": { "type": "string", "minLength": 1 },
              "process": { "type": "string", "minLength": 1 },
              "reset": { "type": "string", "minLength": 1 },
              "release": { "type": "string", "minLength": 1 }
            }
          },
          "state_model": { "type": "string", "minLength": 1 },
          "seed_model": { "type": "string", "minLength": 1 },
          "input_domain": { "type": "string", "minLength": 1 },
          "output_domain": { "type": "string", "minLength": 1 },
          "units": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "latency": { "type": "string", "minLength": 1 },
          "tail": { "type": "string", "minLength": 1 },
          "scheduling": { "type": "string", "minLength": 1 },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "kind",
                "include",
                "qualified_name",
                "target",
                "availability"
              ],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["cpp_type", "cpp_function"] },
                "include": { "type": "string", "pattern": "^pulp/.+\\.hpp$" },
                "qualified_name": { "type": "string", "pattern": "^[A-Za-z_].*::.+$" },
                "target": { "type": "string", "pattern": "^Pulp::[a-z0-9_-]+$" },
                "availability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state", "platforms", "required_features"],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": ["available", "conditional", "unavailable"]
                    },
                    "platforms": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "required_features": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "forge_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalog", "node_key"],
            "properties": {
              "catalog": { "type": "string", "const": "forge-catalog.json" },
              "node_key": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "last_contract_version",
          "last_contract_digest",
          "removed_in_manifest_revision",
          "reason",
          "replacement_key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "last_contract_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer" },
              "minor": { "type": "integer" }
            }
          },
          "last_contract_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "removed_in_manifest_revision": { "type": "integer" },
          "reason": { "type": "string", "minLength": 20 },
          "replacement_key": { "type": ["string", "null"] }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_domain"],
      "properties": {
        "total": { "type": "integer" },
        "by_domain": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_vocabulary"],
      "properties": {
        "signal_vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "source", "entries"],
          "properties": {
            "schema": { "type": "string", "const": "pulp.signal-vocabulary.compat.v1" },
            "source": { "type": "string", "minLength": 1 },
            "entries": {
              "type": "object",
              "propertyNames": { "type": "string", "minLength": 1 },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["class", "methods"],
                  "properties": {
                    "class": { "type": "string", "minLength": 1 },
                    "methods": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
