{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielraffel/pulp/docs/status/agent-capabilities.schema.json",
  "title": "Pulp installed agent capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_minor",
    "manifest_revision",
    "required_features",
    "coverage",
    "capabilities",
    "tombstones",
    "counts",
    "compatibility"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "agent-capabilities.schema.json" },
    "schema": { "type": "string", "const": "pulp.agent-capabilities.v1" },
    "schema_minor": { "type": "integer", "minimum": 0 },
    "manifest_revision": { "type": "integer", "minimum": 1 },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "absence_semantics",
        "domains"
      ],
      "properties": {
        "state": { "type": "string", "enum": ["partial", "complete"] },
        "absence_semantics": { "type": "string", "const": "unknown" },
        "domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "capabilities"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": ["partial", "complete", "not_inventoried"]
              },
              "capabilities": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "domain",
          "summary",
          "contract_version",
          "contract_digest",
          "status",
          "evolution",
          "rt_class",
          "lifecycle",
          "state_model",
          "seed_model",
          "input_domain",
          "output_domain",
          "units",
          "latency",
          "tail",
          "scheduling",
          "bindings"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "enum": ["audio", "midi", "music", "offline", "sequence", "signal", "timebase"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "contract_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer", "minimum": 1 },
              "minor": { "type": "integer", "minimum": 0 }
            }
          },
          "contract_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["stable", "usable", "experimental", "partial", "unsupported", "deprecated"]
          },
          "evolution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "introduced_in"],
                "properties": {
                  "state": { "type": "string", "const": "active" },
                  "introduced_in": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["major", "minor"],
                    "properties": {
                      "major": { "type": "integer", "minimum": 0 },
                      "minor": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "introduced_in", "deprecated_in", "replacement_key"],
                "properties": {
                  "state": { "type": "string", "const": "deprecated" },
                  "introduced_in": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["major", "minor"],
                    "properties": {
                      "major": { "type": "integer", "minimum": 0 },
                      "minor": { "type": "integer", "minimum": 0 }
                    }
                  },
                  "deprecated_in": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["major", "minor"],
                    "properties": {
                      "major": { "type": "integer", "minimum": 0 },
                      "minor": { "type": "integer", "minimum": 0 }
                    }
                  },
                  "replacement_key": { "type": ["string", "null"] }
                }
              }
            ]
          },
          "rt_class": {
            "type": "string",
            "enum": ["audio", "control", "any", "offline", "mixed"]
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["construction", "prepare", "process", "reset", "release"],
            "properties": {
              "construction": { "type": "string", "minLength": 1 },
              "prepare": { "type": "string", "minLength": 1 },
              "process": { "type": "string", "minLength": 1 },
              "reset": { "type": "string", "minLength": 1 },
              "release": { "type": "string", "minLength": 1 }
            }
          },
          "state_model": { "type": "string", "minLength": 1 },
          "seed_model": { "type": "string", "minLength": 1 },
          "determinism": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repeatability",
              "block_partition",
              "platform_scope",
              "transport_history"
            ],
            "properties": {
              "repeatability": {
                "type": "string",
                "enum": ["bit_exact", "tolerance_bounded", "statistical", "not_promised"]
              },
              "block_partition": {
                "type": "string",
                "enum": ["invariant", "fixed_partition_only", "not_applicable"]
              },
              "platform_scope": {
                "type": "string",
                "enum": ["cross_platform", "same_backend", "same_build"]
              },
              "transport_history": {
                "type": "string",
                "enum": ["input", "irrelevant"]
              }
            }
          },
          "input_domain": { "type": "string", "minLength": 1 },
          "output_domain": { "type": "string", "minLength": 1 },
          "units": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "latency": { "type": "string", "minLength": 1 },
          "tail": { "type": "string", "minLength": 1 },
          "scheduling": { "type": "string", "minLength": 1 },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "kind",
                "include",
                "qualified_name",
                "target",
                "availability"
              ],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["cpp_type", "cpp_function"] },
                "include": { "type": "string", "pattern": "^pulp/.+\\.hpp$" },
                "qualified_name": { "type": "string", "pattern": "^[A-Za-z_].*::.+$" },
                "target": { "type": "string", "pattern": "^Pulp::[a-z0-9_-]+$" },
                "availability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["state", "platforms", "required_features"],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": ["available", "conditional", "unavailable"]
                    },
                    "platforms": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "required_features": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "forge_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalog", "node_key"],
            "properties": {
              "catalog": { "type": "string", "const": "forge-catalog.json" },
              "node_key": { "type": "string", "minLength": 1 }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "status": {
                "enum": ["stable", "usable", "experimental", "partial", "unsupported"]
              },
              "evolution": {
                "properties": { "state": { "const": "active" } }
              }
            }
          },
          {
            "properties": {
              "status": { "const": "deprecated" },
              "evolution": {
                "properties": { "state": { "const": "deprecated" } }
              }
            }
          }
        ]
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "last_contract_version",
          "last_contract_digest",
          "status",
          "introduced_in",
          "deprecated_in",
          "removed_in_manifest_revision",
          "reason",
          "replacement_key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "last_contract_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer", "minimum": 0 },
              "minor": { "type": "integer", "minimum": 0 }
            }
          },
          "status": { "type": "string", "const": "removed" },
          "introduced_in": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer", "minimum": 0 },
              "minor": { "type": "integer", "minimum": 0 }
            }
          },
          "deprecated_in": {
            "type": "object",
            "additionalProperties": false,
            "required": ["major", "minor"],
            "properties": {
              "major": { "type": "integer", "minimum": 0 },
              "minor": { "type": "integer", "minimum": 0 }
            }
          },
          "last_contract_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "removed_in_manifest_revision": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 20 },
          "replacement_key": { "type": ["string", "null"] }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_domain"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_domain": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_vocabulary"],
      "properties": {
        "signal_vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "source", "entries"],
          "properties": {
            "schema": { "type": "string", "const": "pulp.signal-vocabulary.compat.v1" },
            "source": { "type": "string", "minLength": 1 },
            "entries": {
              "type": "object",
              "propertyNames": { "type": "string", "minLength": 1 },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["class", "methods", "enums"],
                  "properties": {
                    "class": { "type": "string", "minLength": 1 },
                    "methods": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "enums": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "oneOf": [
                            { "type": "string", "minLength": 1 },
                            {
                              "type": "array",
                              "minItems": 1,
                              "items": { "type": "string", "minLength": 1 }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_minor": { "const": 0 },
        "required_features": {
          "const": [
            "capability-contract-version-v1",
            "coverage-state-v1",
            "design-runtime-separation-v1",
            "tombstones-v1",
            "typed-bindings-v1"
          ]
        }
      }
    },
    {
      "properties": {
        "schema_minor": { "const": 1 },
        "required_features": {
          "const": [
            "capability-contract-version-v1",
            "coverage-state-v1",
            "design-runtime-separation-v1",
            "determinism-contract-v1",
            "tombstones-v1",
            "typed-bindings-v1"
          ]
        },
        "capabilities": {
          "items": { "required": ["determinism"] }
        }
      }
    }
  ]
}
