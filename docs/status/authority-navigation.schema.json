{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulp.audio/schemas/authority-navigation.schema.json",
  "title": "Pulp authority navigation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "registry_revision", "authorities"],
  "properties": {
    "$schema": { "const": "authority-navigation.schema.json" },
    "schema": { "const": "pulp.authority-navigation.v1" },
    "registry_revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "aliases",
          "plane",
          "native_owner",
          "source_location",
          "installed_location",
          "query_or_validator",
          "coverage_semantics",
          "absence_semantics",
          "does_not_prove"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            }
          },
          "plane": {
            "enum": [
              "design_time_static",
              "dsp_static",
              "live_control",
              "offline_command",
              "release_evidence",
              "timeline_static"
            ]
          },
          "native_owner": { "type": "string", "minLength": 1, "maxLength": 512 },
          "source_location": { "type": "string", "minLength": 1, "maxLength": 512 },
          "installed_location": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 512 },
              { "type": "null" }
            ]
          },
          "query_or_validator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "installed"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 512 },
              "installed": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 512 },
                  { "type": "null" }
                ]
              }
            }
          },
          "coverage_semantics": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "absence_semantics": {
            "enum": [
              "not_advertised_by_the_queried_mcp_server",
              "not_present_in_covered_forge_bake_catalog_headers",
              "not_present_in_joined_forge_catalog",
              "not_registered_as_a_top_level_cli_command",
              "not_registered_in_builtin_timeline_schema_registry",
              "requires_exact_live_instance",
              "unknown",
              "unknown_outside_reverified_rows"
            ]
          },
          "does_not_prove": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      }
    }
  }
}
