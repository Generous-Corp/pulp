{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/audio/**",
              "components/buttons/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "components/toggles/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Jost|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Jost, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:nm|tint|led|dd|off|color|empty|key|ref|className|style|children)$/]",
        "message": "<StripSlot> doesn't accept that prop. Declared props: nm, tint, led, dd, off, color, empty."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripSlot'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:fx|inst)$/]",
        "message": "<StripSlot> tint must be one of 'fx' | 'inst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|collapsible|collapsed|defaultCollapsed|onToggle|children|key|ref|className|style|children)$/]",
        "message": "<GroupBox> doesn't accept that prop. Declared props: title, collapsible, collapsed, defaultCollapsed, onToggle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|label|display|size|accent|key|ref|className|style|children)$/]",
        "message": "<Knob> doesn't accept that prop. Declared props: value, min, max, label, display, size, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Knob> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|peak|orientation|height|key|ref|className|style|children)$/]",
        "message": "<Meter> doesn't accept that prop. Declared props: value, peak, orientation, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Meter> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModSource'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|color|depth|bipolar|key|ref|className|style|children)$/]",
        "message": "<ModSource> doesn't accept that prop. Declared props: src, color, depth, bipolar."
      },
      {
        "selector": "JSXOpeningElement[name.name='MusicalTyping'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|held|pressed|pressedBlack|octave|velocity|oct|startC|live|key|ref|className|style|children)$/]",
        "message": "<MusicalTyping> doesn't accept that prop. Declared props: mode, held, pressed, pressedBlack, octave, velocity, oct, startC, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='MusicalTyping'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:type|piano)$/]",
        "message": "<MusicalTyping> mode must be one of 'type' | 'piano'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PropertyPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PropertyPanel> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|vertical|readouts|disabled|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: value, onChange, vertical, readouts, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Recorder'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|time|threshold|level|length|seed|key|ref|className|style|children)$/]",
        "message": "<Recorder> doesn't accept that prop. Declared props: state, time, threshold, level, length, seed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Recorder'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:armed|recording|captured)$/]",
        "message": "<Recorder> state must be one of 'armed' | 'recording' | 'captured'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|unit|min|max|decimals|disabled|key|ref|className|style|children)$/]",
        "message": "<ValueField> doesn't accept that prop. Declared props: value, onChange, unit, min, max, decimals, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveformEditor'] > JSXAttribute > JSXIdentifier[name!=/^(?:seed|height|inPt|outPt|fadeIn|fadeOut|slices|playhead|key|ref|className|style|children)$/]",
        "message": "<WaveformEditor> doesn't accept that prop. Declared props: seed, height, inPt, outPt, fadeIn, fadeOut, slices, playhead."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
