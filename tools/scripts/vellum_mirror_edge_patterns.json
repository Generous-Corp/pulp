{
  "schema": "pulp.vellum.mirror-edge-patterns.v1",
  "description": "Forbidden mirror edges, shared by Pulp's closure gate and Vellum's extraction scan. Paths are relative to the mirror root. Every carried file's suffix is either scanned (suffixes) or declared binary (binary_suffixes). The Pulp-kept rules and approved_exceptions are generated by tools/scripts/vellum_mirror_edge_table.py from the view-audio headers, the D3 units' pulp_kept files and the view-audio seam debts; an approved exception exempts one exact line of one file from one content rule.",
  "suffixes": [
    "",
    ".c",
    ".cc",
    ".cmake",
    ".cpp",
    ".cxx",
    ".h",
    ".hh",
    ".hpp",
    ".hxx",
    ".in",
    ".inl",
    ".ipp",
    ".js",
    ".json",
    ".m",
    ".md",
    ".mjs",
    ".mm",
    ".ps1",
    ".py",
    ".sh",
    ".ts",
    ".tsx",
    ".txt",
    ".yaml",
    ".yml"
  ],
  "binary_suffixes": [
    ".otf",
    ".png",
    ".ttf",
    ".woff",
    ".woff2"
  ],
  "content_patterns": {
    "mirror-product-include": "#\\s*(?:include|import)\\s*[<\\\"](?:pulp/(?:audio|signal|midi|music|format|host|gpu_audio|content)/|pluginterfaces/|public\\.sdk/|clap/|lv2/|AudioUnitSDK/|oboe/|AudioToolbox/|AudioUnit/|CoreAudio/|CoreAudioKit/|CoreMIDI/|AVFAudio/)",
    "mirror-product-symbol": "\\bpulp::(?:audio|signal|midi|music|format|host|gpu_audio|content)\\b|\\bpulp[-_](?:audio|signal|midi|music|format|host|gpu[-_]audio|content)\\b",
    "mirror-audio-framework-link": "\\b(?:AudioToolbox|AudioUnit|CoreAudio|CoreAudioKit|CoreMIDI|AVFAudio)\\.framework\\b|-framework\\s+(?:AudioToolbox|AudioUnit|CoreAudio|CoreAudioKit|CoreMIDI|AVFAudio)\\b",
    "mirror-pulp-kept-include": "#\\s*(?:include|import)\\s*[<\\\"](?:pulp/view/(?:audio/|(?:widgets/)?(?:audio_bridge|audio_inspector_\\w+|eq_curve_view|midi_binding|midi_keyboard|musical_typing_keyboard\\w*|plugin_manager_panel|sample_asset_drop_target|step_grid_view|waveform_\\w+|graph_editor_view)\\.h)|pulp/state/content_registry\\.h|(?:pulp/view/audio_inspector_panel\\.hpp|pulp/view/audio_inspector_window\\.hpp|pulp/view/audio_widgets\\.hpp|pulp/view/editor_bridge\\.hpp|pulp/view/eq_curve_view\\.hpp|pulp/view/host_param_surface\\.hpp|pulp/view/hosted_editor_attachment\\.hpp|pulp/view/inspector\\.hpp|pulp/view/inspector_window\\.hpp|pulp/view/midi_binding\\.hpp|pulp/view/plugin_frame_renderer\\.hpp|pulp/view/plugin_manager_panel\\.hpp|pulp/view/register_audio_widgets\\.hpp|pulp/view/sample_asset_drop_target\\.hpp|pulp/view/script_inspector_bridge\\.hpp|pulp/view/visualization_bridge\\.hpp|pulp/view/visualizers\\.hpp|pulp/view/waveform_editor_primitives\\.hpp|pulp/view/waveform_gpu_primitives\\.hpp|pulp/view/waveform_gpu_render_controller\\.hpp|pulp/view/waveform_headless_render_backend\\.hpp|pulp/view/waveform_overview_view\\.hpp|pulp/view/widgets/graph_editor_view\\.hpp)[>\\\"])",
    "mirror-pulp-kept-symbol": "\\b(?:bind_midi_cc|bind_midi_note|dbfs_meter_fill|fill_waveform_peak_vertices|register_audio_widgets|to_cc_value)\\b"
  },
  "path_patterns": {
    "mirror-pulp-kept-file": "\\A(?:core/(?:view/(?:audio/|(?:.*/)?(?:audio_bridge|audio_inspector_\\w+|eq_curve_view|midi_binding|midi_keyboard|musical_typing_keyboard\\w*|plugin_manager_panel|sample_asset_drop_target|step_grid_view|waveform_\\w+|graph_editor_view)\\.)|host/|state/(?:.*/)?content_registry\\.)|(?:core/view/include/pulp/view/editor_bridge\\.hpp|core/view/include/pulp/view/host_param_surface\\.hpp|core/view/include/pulp/view/inspector\\.hpp|core/view/include/pulp/view/inspector_window\\.hpp|core/view/include/pulp/view/plugin_frame_renderer\\.hpp|core/view/include/pulp/view/script_inspector_bridge\\.hpp|core/view/include/pulp/view/waveform_editor_primitives\\.hpp|core/view/platform/ios/plugin_view_host_ios\\.mm|core/view/platform/linux/plugin_view_host_linux\\.cpp|core/view/platform/mac/plugin_view_host_mac\\.mm|core/view/platform/mac/plugin_view_host_mac_drag\\.mm|core/view/platform/mac/plugin_view_host_mac_script_keys\\.hpp|core/view/platform/mac/plugin_view_host_mac_text_input\\.mm|core/view/platform/mac/plugin_view_host_mac_view\\.h|core/view/platform/win/plugin_view_host_win\\.cpp|core/view/src/editor_bridge\\.cpp|core/view/src/host_param_surface\\.cpp|core/view/src/inspector\\.cpp|core/view/src/inspector_window\\.cpp|core/view/src/plugin_frame_renderer\\.cpp|core/view/src/plugin_view_host_stub\\.cpp|core/view/src/script_inspector_bridge\\.cpp|core/view/src/waveform_editor_primitives\\.cpp)\\Z)"
  },
  "approved_exceptions": [
    {
      "rule": "mirror-pulp-kept-include",
      "path": "core/view/include/pulp/view/widgets.hpp",
      "line": "#include <pulp/view/audio_widgets.hpp>",
      "debt": "vellum-header-audio-widgets-include"
    }
  ]
}
