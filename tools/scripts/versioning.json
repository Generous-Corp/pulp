{
  "$schema": "./versioning.schema.json",
  "schema_version": 1,

  "_comment_post_merge": "Model B — PRs touch NO version files; version-at-land infers the level from the heuristic and assigns it on merge (--mode=apply is a no-op; the gate stops requiring a file bump for a touched surface but still hard-fails a fix/feat the heuristic scores none everywhere). One source of truth read by the pre-push hook, gates.sh, and version-skill-check.yml. See docs/guides/version-at-land-cutover.md.",
  "post_merge_assignment": true,
  "_comment": "Repo-agnostic config for version_bump_check.py and skill_sync_check.py. Pivoted from YAML to JSON to avoid the PyYAML install friction on PEP-668 Python. Schema and field names unchanged; see planning/versioning-and-skill-sync-plan.md for the design.",

  "surfaces": {
    "sdk": {
      "label": "Pulp SDK / CLI",
      "version_files": [
        { "path": "CMakeLists.txt", "kind": "cmake_project_version" }
      ],
      "trigger_paths": [
        "core/**/include/**/*.hpp",
        "core/**/include/**/*.h",
        "core/**/src/**/*.hpp",
        "core/**/src/**/*.h",
        "core/**/src/**/*.cpp",
        "core/**/src/**/*.mm",
        "core/**/src/**/*.c",
        "core/**/js/**",
        "core/**/platform/**",
        "inspect/include/**",
        "inspect/src/**",
        "inspect/CMakeLists.txt",
        "tools/cmake/PulpInstallRules.cmake",
        "tools/cmake/PulpSdkProvenance.cmake",
        "tools/cmake/PulpAuv3.cmake",
        "tools/cmake/PulpPluginFormats.cmake",
        "tools/cmake/PulpUtils.cmake",
        "tools/cmake/PulpAAX.cmake",
        "tools/cmake/PulpAppIcon.cmake",
        "tools/cmake/PulpAppTargets.cmake",
        "tools/cmake/PulpBuildInfo.cmake",
        "tools/cmake/PulpBundleRelocatable.cmake",
        "tools/cmake/PulpControlShipping.cmake",
        "tools/cmake/PulpDocumentTypes.cmake",
        "tools/cmake/PulpEmbedData.cmake",
        "tools/cmake/PulpFinalizeBuildInfo.cmake",
        "tools/cmake/PulpFindPluginval.cmake",
        "tools/cmake/PulpFonts.cmake",
        "tools/cmake/PulpGenerateMacIcns.cmake",
        "tools/cmake/PulpGpuProvider.cmake",
        "tools/cmake/PulpInspectorShipping.cmake",
        "tools/cmake/PulpInstall.cmake",
        "tools/cmake/PulpIosHostApp.cmake",
        "tools/cmake/PulpJsBytecode.cmake",
        "tools/cmake/PulpLinkFontconfig.cmake",
        "tools/cmake/PulpMacosArchiveFloor.cmake",
        "tools/cmake/PulpMidiTuning.cmake",
        "tools/cmake/PulpMinOs.cmake",
        "tools/cmake/PulpPkgConfigImports.cmake",
        "tools/cmake/PulpPlatformConfig.cmake",
        "tools/cmake/PulpPlugin.cmake",
        "tools/cmake/PulpPluginMetadata.cmake",
        "tools/cmake/PulpPortable.cmake",
        "tools/cmake/PulpReactRuntime.cmake",
        "tools/cmake/PulpReload.cmake",
        "tools/cmake/PulpRuntimeStaging.cmake",
        "tools/cmake/PulpSdkGuards.cmake",
        "tools/cmake/PulpSkiaDawnProvider.cmake",
        "tools/cmake/PulpSkiaIcuData.cmake",
        "tools/cmake/PulpSparkle.cmake",
        "tools/cmake/PulpStageMachOLinkedRuntime.cmake",
        "tools/cmake/PulpUiAssets.cmake",
        "tools/cmake/PulpVerifyRuntimeStaging.cmake",
        "tools/cmake/PulpWebGpuImportedTarget.cmake",
        "tools/cmake/PulpWindowsTargetArch.cmake",
        "experimental/pulp-rs/Cargo.toml",
        "experimental/pulp-rs/Cargo.lock",
        "experimental/pulp-rs/src/**/*.rs",
        "experimental/pulp-rs/tests/**/*.rs",
        "tools/cli/**/*.cpp",
        "tools/cli/**/*.hpp",
        "tools/cli/**/*.h",
        "tools/audio/host-probe/**",
        "tools/rack/**",
        "tools/scripts/build_combined_installer.sh",
        "tools/scripts/sdk_provenance.py",
        "tools/scripts/release_product_matrix.json",
        "packages/pulp-react/src/**",
        "tools/import-design/CMakeLists.txt",
        "tools/import-design/**/*.cpp",
        "tools/import-design/**/*.hpp",
        "tools/import-design/**/*.h"
      ],
      "public_api_paths": [
        "core/**/include/**/*.hpp",
        "core/**/include/**/*.h",
        "inspect/include/**",
        "inspect/CMakeLists.txt",
        "tools/cmake/PulpInstallRules.cmake",
        "tools/cmake/PulpSdkProvenance.cmake",
        "tools/cmake/PulpAuv3.cmake"
      ],
      "internal_only_paths": [
        "core/**/src/**",
        "core/**/js/**",
        "core/**/platform/**",
        "inspect/src/**",
        "packages/pulp-react/src/**"
      ],
      "changelog": "CHANGELOG.md"
    },

    "plugin": {
      "label": "Claude Code plugin",
      "version_files": [
        { "path": ".claude-plugin/plugin.json", "kind": "json_field", "field": "version" },
        { "path": ".claude-plugin/marketplace.json", "kind": "json_field", "field": "version" },
        { "path": ".claude-plugin/marketplace.json", "kind": "json_path",  "field": "plugins.0.version" }
      ],
      "trigger_paths": [
        ".claude-plugin/**",
        ".claude/commands/**",
        ".agents/skills/**",
        "hooks/**"
      ],
      "public_api_paths": [
        ".claude-plugin/plugin.json",
        ".claude/commands/**"
      ],
      "internal_only_paths": [
        "hooks/scripts/**"
      ],
      "changelog": "CHANGELOG.md"
    }
  },

  "skills": {
    "skills_dir": ".agents/skills",
    "path_map": "tools/scripts/skill_path_map.json"
  },

  "_comment_generated_globs": "Paths no author writes by hand, so a change to one is never evidence of a decision that owes a SKILL.md update. The two GPU/Vellum handoff files are generated by gpu_handoff_provenance.py write --receipt, which version_at_land._refresh_derived now runs inside the version bot's bump commit — so without these entries every bump PR would fail the required Enforce version & skill sync check on files the bot itself wrote.",
  "generated_globs": [
    "build/**",
    "**/*.generated.*",
    "tools/cli/pulp_version_gen.h*",
    "external/**",
    "node_modules/**",
    "*.lock",
    "*.lockb",
    "docs/status/gpu-vellum-handoff.yaml",
    "docs/validation/gpu-handoff-provenance/receipt.json"
  ],

  "trailers": {
    "version_bump": "Version-Bump",
    "skill_update": "Skill-Update",
    "release": "Release"
  }
}
