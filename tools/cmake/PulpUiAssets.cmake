# Pulp UI and kit-asset helpers.
# Included by PulpUtils.cmake to preserve its public compatibility surface.

function(_pulp_normalize_ui_script_path out_var source_dir ui_script)
    if(NOT ui_script)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()

    if(IS_ABSOLUTE "${ui_script}")
        set(_ui_script_path "${ui_script}")
    else()
        set(_ui_script_path "${source_dir}/${ui_script}")
    endif()

    get_filename_component(_ui_script_path "${_ui_script_path}" ABSOLUTE)
    file(TO_CMAKE_PATH "${_ui_script_path}" _ui_script_path)
    set(${out_var} "${_ui_script_path}" PARENT_SCOPE)
endfunction()

# pulp_add_binary_data(), which encodes the UI script into the image.
include("${CMAKE_CURRENT_LIST_DIR}/PulpEmbedData.cmake")

# Whether a format target also compiles in the absolute on-disk UI_SCRIPT (and
# theme) path. Only a dev build (PULP_DEV_BUILD, which the root CMakeLists
# defaults from PULP_BUILD_TESTS) does: the editor reads that file only while
# hot reload is enabled (the standalone host, or a DAW launched with
# PULP_DEV_HOT_RELOAD=1) and only while the file exists. Every other build and
# every other open evaluates the embedded bytes, so a shipped image never
# names, or depends on, the developer's source tree.
# Declared here as well as in the root CMakeLists so an installed-SDK consumer
# has the option: there it defaults OFF (embed only) and the CLI's configure
# passes -DPULP_DEV_BUILD=ON for the developer loop. The root CMakeLists
# declares it first for the in-tree checkout, so this is a no-op there.
if(NOT DEFINED PULP_DEV_BUILD)
    option(PULP_DEV_BUILD
        "Compile development-only paths (on-disk ui.js override) in" OFF)
endif()

function(_pulp_ui_script_dev_path_enabled out_var)
    if(PULP_DEV_BUILD)
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

# One static library per distinct (script, theme, priority): the encoded bytes,
# plus a registration unit that installs them through
# pulp::format::register_embedded_editor_ui() from its static initializer. The
# registration unit is returned separately because it must be a direct source
# of the format target -- an object nothing references is dropped from an
# archive, and with it the initializer.
function(_pulp_ui_script_embed_target out_lib out_registration script_path theme_path priority)
    string(SHA1 _key "${script_path}|${theme_path}|${priority}")
    string(SUBSTRING "${_key}" 0 12 _key)
    set(_lib "pulp_ui_embed_${_key}")
    get_property(_registration GLOBAL PROPERTY "PULP_UI_EMBED_${_lib}_REGISTRATION")
    if(NOT TARGET "${_lib}")
        set(_sources "${script_path}")
        if(theme_path)
            list(APPEND _sources "${theme_path}")
        endif()
        pulp_add_binary_data(${_lib} SOURCES ${_sources} NAMESPACE ${_lib})

        get_filename_component(_script_name "${script_path}" NAME)
        string(MAKE_C_IDENTIFIER "${_script_name}" _script_var)
        if(theme_path)
            get_filename_component(_theme_name "${theme_path}" NAME)
            string(MAKE_C_IDENTIFIER "${_theme_name}" _theme_var)
            set(_theme_expr "${_lib}::${_theme_var}, ${_lib}::${_theme_var}_size")
        else()
            set(_theme_expr "nullptr, 0")
        endif()
        set(_registration "${CMAKE_CURRENT_BINARY_DIR}/${_lib}_register.cpp")
        set(_content "// Generated by pulp_add_plugin(UI_SCRIPT): registers the embedded editor UI.\n")
        string(APPEND _content "#include <pulp/format/editor_ui_embed.hpp>\n")
        string(APPEND _content "#include \"${_lib}_data.hpp\"\n\n")
        string(APPEND _content "namespace {\n")
        string(APPEND _content "const pulp::format::EmbeddedEditorUi kEmbeddedEditorUi{\n")
        string(APPEND _content "    \"${_script_name}\", ${_lib}::${_script_var}, ${_lib}::${_script_var}_size,\n")
        string(APPEND _content "    ${_theme_expr}, ${priority}};\n")
        string(APPEND _content "const pulp::format::EmbeddedEditorUiRegistration kRegistration{&kEmbeddedEditorUi};\n")
        string(APPEND _content "}  // namespace\n")
        set(_existing "")
        if(EXISTS "${_registration}")
            file(READ "${_registration}" _existing)
        endif()
        if(NOT "${_existing}" STREQUAL "${_content}")
            file(WRITE "${_registration}" "${_content}")
        endif()
        set_property(GLOBAL PROPERTY "PULP_UI_EMBED_${_lib}_REGISTRATION" "${_registration}")
    endif()
    set(${out_lib} "${_lib}" PARENT_SCOPE)
    set(${out_registration} "${_registration}" PARENT_SCOPE)
endfunction()

# Attach a UI script to one format target: embed its bytes (and the theme
# beside it) so the image carries the editor, and in a dev build also define
# PULP_UI_SCRIPT_PATH for the hot-reloading edit-and-see loop.
#   THEME <path>   theme override to embed with the script; defaults to a
#                  theme.json beside the script when one exists at configure
#                  time (add one later and reconfigure).
#   PRIORITY <n>   registration priority; pulp_use_kit_ui registers above the
#                  plug-in's own UI_SCRIPT so the kit wins, as its definition
#                  did.
function(_pulp_apply_ui_script_definition target ui_script_path)
    if(NOT ui_script_path)
        return()
    endif()
    cmake_parse_arguments(UI "" "THEME;PRIORITY" "" ${ARGN})
    if(NOT DEFINED UI_PRIORITY)
        set(UI_PRIORITY 0)
    endif()
    get_filename_component(_script_dir "${ui_script_path}" DIRECTORY)
    if(NOT DEFINED UI_THEME)
        set(UI_THEME "")
        if(EXISTS "${_script_dir}/theme.json")
            set(UI_THEME "${_script_dir}/theme.json")
        endif()
    endif()

    # Adding the script, or a theme.json beside it, after configure must
    # reconfigure: the embed is decided here, not at build time.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_script_dir}")
    if(EXISTS "${ui_script_path}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ui_script_path}")
    endif()
    if(UI_THEME AND EXISTS "${UI_THEME}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${UI_THEME}")
    endif()

    _pulp_ui_script_dev_path_enabled(_dev_path)
    # An embedded editor has no script directory to resolve relative assets
    # from, and without the dev build it has no asset roots either, so images
    # or fonts beside the script are unreachable from the shipped editor.
    if(NOT _dev_path AND EXISTS "${ui_script_path}")
        file(GLOB _sibling_assets LIST_DIRECTORIES false
            "${_script_dir}/*.png" "${_script_dir}/*.jpg" "${_script_dir}/*.jpeg"
            "${_script_dir}/*.gif" "${_script_dir}/*.webp" "${_script_dir}/*.svg"
            "${_script_dir}/*.ttf" "${_script_dir}/*.otf"
            "${_script_dir}/*.woff" "${_script_dir}/*.woff2")
        get_property(_warned GLOBAL PROPERTY "PULP_UI_EMBED_ASSET_WARNED_${ui_script_path}")
        if(_sibling_assets AND NOT _warned)
            set_property(GLOBAL PROPERTY "PULP_UI_EMBED_ASSET_WARNED_${ui_script_path}" TRUE)
            list(LENGTH _sibling_assets _sibling_count)
            message(WARNING
                "UI_SCRIPT ${ui_script_path}: ${_sibling_count} image/font file(s) sit beside "
                "the script, but the embedded editor cannot read them (no script directory "
                "and no asset roots outside a PULP_DEV_BUILD). Inline them into the script "
                "(data: URLs) or embed them for native code with pulp_embed_files().")
        endif()
    endif()

    # A script that does not exist yet cannot be encoded; pulp_add_plugin has
    # already warned that the editor falls back to AutoUi until it does.
    if(EXISTS "${ui_script_path}")
        _pulp_ui_script_embed_target(_embed_lib _embed_registration
            "${ui_script_path}" "${UI_THEME}" "${UI_PRIORITY}")
        target_sources(${target} PRIVATE "${_embed_registration}")
        target_link_libraries(${target} PRIVATE ${_embed_lib})
    endif()

    if(_dev_path)
        target_compile_definitions(${target} PRIVATE
            PULP_UI_SCRIPT_PATH="${ui_script_path}"
        )
    endif()
endfunction()

function(_pulp_apply_ui_theme_definition target theme_path)
    if(NOT theme_path)
        return()
    endif()

    # The on-disk theme path belongs with the on-disk script; an embedded
    # document reads the embedded theme bytes instead.
    _pulp_ui_script_dev_path_enabled(_dev_path)
    if(NOT _dev_path)
        return()
    endif()
    target_compile_definitions(${target} PRIVATE
        PULP_UI_THEME_PATH="${theme_path}"
    )
endfunction()

function(_pulp_apply_ui_asset_roots_definition target asset_roots)
    if(NOT asset_roots)
        return()
    endif()

    # Asset roots are absolute source paths too: a shipped image must not name
    # or read them. An embedded editor resolves relative assets only from these
    # roots in a dev build; a release build has none.
    _pulp_ui_script_dev_path_enabled(_dev_path)
    if(NOT _dev_path)
        return()
    endif()
    target_compile_definitions(${target} PRIVATE
        PULP_UI_ASSET_ROOTS="${asset_roots}"
    )
endfunction()

function(_pulp_select_kit_export out_var helper_name kit_target property explicit_value label)
    get_target_property(_values "${kit_target}" "${property}")
    if(NOT _values)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()

    set(_selected "")
    if(explicit_value)
        foreach(_value IN LISTS _values)
            if(_value STREQUAL explicit_value)
                set(_selected "${_value}")
            endif()
        endforeach()
        if(NOT _selected)
            message(FATAL_ERROR
                "${helper_name}: ${label} '${explicit_value}' is not exported by the kit")
        endif()
    else()
        list(LENGTH _values _value_count)
        if(_value_count EQUAL 1)
            list(GET _values 0 _selected)
        elseif(_value_count GREATER 1)
            message(FATAL_ERROR
                "${helper_name}: kit exports multiple ${label} entries; pass ${label} <path>")
        endif()
    endif()

    set(${out_var} "${_selected}" PARENT_SCOPE)
endfunction()

function(_pulp_absolute_project_path out_var path)
    if(NOT path)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    if(IS_ABSOLUTE "${path}")
        set(_abs "${path}")
    else()
        set(_abs "${CMAKE_SOURCE_DIR}/${path}")
    endif()
    get_filename_component(_abs "${_abs}" ABSOLUTE)
    file(TO_CMAKE_PATH "${_abs}" _abs)
    set(${out_var} "${_abs}" PARENT_SCOPE)
endfunction()

function(_pulp_absolute_project_paths out_var)
    set(_out)
    foreach(_path IN LISTS ARGN)
        _pulp_absolute_project_path(_abs "${_path}")
        if(_abs)
            list(APPEND _out "${_abs}")
        endif()
    endforeach()
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()

function(_pulp_pipe_join out_var)
    set(_joined "")
    foreach(_value IN LISTS ARGN)
        if(_value MATCHES "\\|")
            message(FATAL_ERROR
                "pulp_use_kit_ui: asset root paths must not contain '|': ${_value}")
        endif()
        if(_joined)
            string(APPEND _joined "|")
        endif()
        string(APPEND _joined "${_value}")
    endforeach()
    set(${out_var} "${_joined}" PARENT_SCOPE)
endfunction()

function(pulp_use_kit_ui target kit_target)
    set(options)
    set(oneValueArgs SCRIPT TOKENS)
    set(multiValueArgs)
    cmake_parse_arguments(KIT_UI "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(KIT_UI_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR
            "pulp_use_kit_ui(${target} ${kit_target}): unknown arguments: ${KIT_UI_UNPARSED_ARGUMENTS}")
    endif()

    if(NOT TARGET "${target}_Core")
        message(FATAL_ERROR
            "pulp_use_kit_ui(${target} ...): call this after pulp_add_plugin(${target} ...)")
    endif()
    if(NOT TARGET "${kit_target}")
        message(FATAL_ERROR
            "pulp_use_kit_ui(${target} ${kit_target}): kit target does not exist. "
            "Apply the kit and include(cmake/pulp-kits.cmake OPTIONAL) first.")
    endif()

    _pulp_select_kit_export(_selected_script
        "pulp_use_kit_ui(${target} ${kit_target})"
        "${kit_target}" PULP_UI_SCRIPTS "${KIT_UI_SCRIPT}" "SCRIPT")
    if(NOT _selected_script)
        message(FATAL_ERROR
            "pulp_use_kit_ui(${target} ${kit_target}): kit exports no PULP_UI_SCRIPTS")
    endif()

    _pulp_select_kit_export(_selected_tokens
        "pulp_use_kit_ui(${target} ${kit_target})"
        "${kit_target}" PULP_DESIGN_TOKENS "${KIT_UI_TOKENS}" "TOKENS")
    get_target_property(_selected_assets "${kit_target}" PULP_ASSETS)
    if(NOT _selected_assets)
        set(_selected_assets)
    endif()

    _pulp_absolute_project_path(_selected_script_abs "${_selected_script}")
    _pulp_absolute_project_path(_selected_tokens_abs "${_selected_tokens}")
    _pulp_absolute_project_paths(_selected_assets_abs ${_selected_assets})
    _pulp_pipe_join(_selected_assets_joined ${_selected_assets_abs})

    if(NOT EXISTS "${_selected_script_abs}")
        message(WARNING
            "pulp_use_kit_ui(${target} ${kit_target}): selected UI script is missing: "
            "${_selected_script_abs}")
    endif()
    if(_selected_tokens_abs AND NOT EXISTS "${_selected_tokens_abs}")
        message(WARNING
            "pulp_use_kit_ui(${target} ${kit_target}): selected design token file is missing: "
            "${_selected_tokens_abs}")
    endif()

    set(PULP_${target}_UI_SCRIPT "${_selected_script_abs}" CACHE INTERNAL "")
    if(_selected_tokens_abs)
        set(PULP_${target}_UI_THEME "${_selected_tokens_abs}" CACHE INTERNAL "")
    endif()
    if(_selected_assets_joined)
        set(PULP_${target}_UI_ASSET_ROOTS "${_selected_assets_joined}" CACHE INTERNAL "")
    endif()
    set_property(TARGET "${target}_Core" PROPERTY PULP_KIT_UI_TARGET "${kit_target}")
    set_property(TARGET "${target}_Core" PROPERTY PULP_KIT_UI_SCRIPT "${_selected_script}")
    if(_selected_tokens)
        set_property(TARGET "${target}_Core" PROPERTY PULP_KIT_UI_TOKENS "${_selected_tokens}")
    endif()
    if(_selected_assets)
        set_property(TARGET "${target}_Core" PROPERTY PULP_KIT_UI_ASSETS "${_selected_assets}")
    endif()

    set(_applied_targets)
    foreach(_fmt VST3 CLAP AU LV2 AAX AUv3 Standalone)
        if(TARGET "${target}_${_fmt}")
            _pulp_apply_ui_script_definition("${target}_${_fmt}" "${_selected_script_abs}"
                THEME "${_selected_tokens_abs}" PRIORITY 1)
            _pulp_apply_ui_theme_definition("${target}_${_fmt}" "${_selected_tokens_abs}")
            _pulp_apply_ui_asset_roots_definition("${target}_${_fmt}" "${_selected_assets_joined}")
            list(APPEND _applied_targets "${target}_${_fmt}")
        endif()
    endforeach()

    if(NOT _applied_targets)
        message(WARNING
            "pulp_use_kit_ui(${target} ${kit_target}): no existing format targets were found; "
            "call this after pulp_add_plugin has created at least one format target")
    endif()
endfunction()
