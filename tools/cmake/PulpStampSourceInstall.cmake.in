# Generated at configure time; run after installing build_info.hpp.
set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_sha "@PULP_SOURCE_INSTALL_SHA@")
set(_dirty "@PULP_SOURCE_INSTALL_DIRTY@")
# Whether pulp-view-script carries the shell exec/execAsync JS bridge
# (PULP_DEV_BRIDGE_EXEC); a consumer reads it as `bridge_exec`.
set(_bridge_exec "@PULP_SOURCE_INSTALL_BRIDGE_EXEC@")
set(_os "@PULP_SOURCE_INSTALL_OS@")
set(_arch_list "@PULP_SOURCE_INSTALL_ARCH@")
# One spelling per architecture, whichever toolchain named it: x64 for
# x86_64/amd64 (an Android x86_64 ABI included) and arm64 for aarch64. Any
# other name is lowercased with characters outside [a-z0-9-] turned into
# "-". Two distinct architectures (a universal macOS build) stamp
# "universal".
set(_archs "")
foreach(_arch IN LISTS _arch_list)
    string(TOLOWER "${_arch}" _arch)
    if(_arch MATCHES "^(x86_64|amd64|x64)$")
        set(_arch "x64")
    elseif(_arch MATCHES "^(aarch64|arm64)$")
        set(_arch "arm64")
    endif()
    string(REGEX REPLACE "[^a-z0-9-]" "-" _arch "${_arch}")
    if(NOT _arch STREQUAL "")
        list(APPEND _archs "${_arch}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _archs)
list(LENGTH _archs _arch_count)
if(_arch_count EQUAL 1)
    set(_platform "${_os}-${_archs}")
elseif(_arch_count GREATER 1)
    set(_platform "${_os}-universal")
else()
    set(_platform "${_os}-unknown")
endif()
# The PULP_PROFILE the install was configured under; a consumer reads it as
# `build_profile`.
set(_build_profile "@PULP_PROFILE@")
# An overridden release profile (PULP_PROFILE_ALLOW_OVERRIDE) is a dev build.
if("@PULP_PROFILE_OVERRIDDEN@")
    set(_build_profile "dev")
endif()
string(LENGTH "${_sha}" _sha_length)
if(NOT _sha_length EQUAL 40 OR NOT _sha MATCHES "^[0-9a-f]+$" OR
   NOT _dirty MATCHES "^(true|false)$" OR NOT _bridge_exec MATCHES "^(true|false)$" OR
   NOT _platform MATCHES "^(android|darwin|ios|linux|windows)-[a-z0-9-]+$" OR
   NOT _build_profile MATCHES "^(dev|release)$")
    message(FATAL_ERROR "Pulp source install provenance: invalid build identity")
endif()
set(_marker "${_prefix}/sdk-provenance.json")
set(_content "{\n  \"schema\": \"pulp.sdk-provenance.v1\",\n  \"kind\": \"source-install\",\n  \"distribution_eligible\": false,\n  \"source_git_sha\": \"${_sha}\",\n  \"source_git_dirty\": ${_dirty},\n  \"bridge_exec\": ${_bridge_exec},\n  \"platform\": \"${_platform}\",\n  \"build_profile\": \"${_build_profile}\"\n}\n")
if(EXISTS "${_marker}")
    file(READ "${_marker}" _existing)
    if(NOT _existing STREQUAL _content)
        message(FATAL_ERROR "Pulp source install provenance: refusing to replace ${_marker}")
    endif()
else()
    file(WRITE "${_marker}" "${_content}")
endif()
