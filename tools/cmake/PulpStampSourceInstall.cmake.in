# Generated at configure time; run after installing build_info.hpp.
set(_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_sha "@PULP_SOURCE_INSTALL_SHA@")
set(_dirty "@PULP_SOURCE_INSTALL_DIRTY@")
# Whether pulp-view-script carries the shell exec/execAsync JS bridge
# (PULP_DEV_BRIDGE_EXEC); a consumer reads it as `bridge_exec`.
set(_bridge_exec "@PULP_SOURCE_INSTALL_BRIDGE_EXEC@")
string(LENGTH "${_sha}" _sha_length)
if(NOT _sha_length EQUAL 40 OR NOT _sha MATCHES "^[0-9a-f]+$" OR
   NOT _dirty MATCHES "^(true|false)$" OR NOT _bridge_exec MATCHES "^(true|false)$")
    message(FATAL_ERROR "Pulp source install provenance: invalid build identity")
endif()
set(_marker "${_prefix}/sdk-provenance.json")
set(_content "{\n  \"schema\": \"pulp.sdk-provenance.v1\",\n  \"kind\": \"source-install\",\n  \"distribution_eligible\": false,\n  \"source_git_sha\": \"${_sha}\",\n  \"source_git_dirty\": ${_dirty},\n  \"bridge_exec\": ${_bridge_exec}\n}\n")
if(EXISTS "${_marker}")
    file(READ "${_marker}" _existing)
    if(NOT _existing STREQUAL _content)
        message(FATAL_ERROR "Pulp source install provenance: refusing to replace ${_marker}")
    endif()
else()
    file(WRITE "${_marker}" "${_content}")
endif()
