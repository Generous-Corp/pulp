# PulpEditorPackage.cmake — pulp_add_plugin(... UI <package>).
#
# A UI package is a CMake target that supplies a plug-in's default editor
# through the editor-host contract (pulp/format/editor_host.hpp). It declares
# two target properties:
#
#   PULP_EDITOR_FACTORY_FUNCTION  fully qualified name of a function
#                                 `::pulp::format::EditorFactory* name()`
#   PULP_EDITOR_FACTORY_HEADER    the header on the package's include path
#                                 that declares it
#
# An installed package lists both in its targets' EXPORT_PROPERTIES so they
# survive install(EXPORT).
#
# For each format and standalone target of the plug-in, pulp_add_plugin links
# the package and generates one source that defines the hook (internal
# linkage) and installs it at static init with
# pulp::format::install_plugin_editor_factory_hook(). The hook lives in that
# target's own image, so two plug-ins in one host process never share or
# replace each other's choice. `UI none`, or no UI argument, generates and
# links nothing.
#
# A UI package plug-in links no Pulp view layer: pulp_add_plugin treats
# UI <package> as NO_EDITOR, and rejects NATIVE_UI, UI_SCRIPT, GPU_UI,
# FULL_EDITOR and LITE_EDITOR beside it.

# Every per-plug-in target that constructs the plug-in's processor.
set(_PULP_UI_PACKAGE_TARGET_SUFFIXES
    VST3 CLAP AU LV2 AAX AUv3 AUv3Framework Standalone ControlHost)

# The formats whose adapter opens an editor through the editor-host contract
# today. A UI package plug-in links no Pulp view layer, so a format missing
# here builds with no editor at all, and pulp_add_plugin says so.
set(_PULP_CONTRACT_EDITOR_FORMATS VST3 CLAP AU Standalone)

# Warn, naming them, when a UI package plug-in builds formats whose adapter
# does not open contract editors yet.
function(_pulp_warn_ui_package_formats target ui)
    set(_missing "")
    foreach(_format VST3 CLAP AU LV2 AAX AUv3 Standalone)
        if(TARGET "${target}_${_format}" AND NOT _format IN_LIST _PULP_CONTRACT_EDITOR_FORMATS)
            list(APPEND _missing "${_format}")
        endif()
    endforeach()
    if(_missing)
        list(JOIN _missing ", " _missing_text)
        message(WARNING
            "pulp_add_plugin(${target}): UI ${ui}: ${_missing_text} do not open "
            "editor-host contract editors yet, so those builds have no editor.")
    endif()
endfunction()

# Read and check a UI package's declaration. Sets out_function and out_header
# to empty for `none` or an empty value.
function(_pulp_resolve_ui_package context ui out_function out_header)
    set(${out_function} "" PARENT_SCOPE)
    set(${out_header} "" PARENT_SCOPE)
    if("${ui}" STREQUAL "" OR "${ui}" STREQUAL "none")
        return()
    endif()
    if(NOT TARGET "${ui}")
        message(FATAL_ERROR
            "${context}: UI '${ui}' is not a target. Define or find_package() the UI "
            "package before pulp_add_plugin(), or pass UI none for a headless plug-in.")
    endif()
    get_target_property(_function "${ui}" PULP_EDITOR_FACTORY_FUNCTION)
    get_target_property(_header "${ui}" PULP_EDITOR_FACTORY_HEADER)
    if(NOT _function OR NOT _header)
        message(FATAL_ERROR
            "${context}: UI package '${ui}' must set the target properties "
            "PULP_EDITOR_FACTORY_FUNCTION (a function returning "
            "::pulp::format::EditorFactory*) and PULP_EDITOR_FACTORY_HEADER "
            "(the header that declares it).")
    endif()
    if(NOT _function MATCHES "^(::)?[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$")
        message(FATAL_ERROR
            "${context}: UI package '${ui}' PULP_EDITOR_FACTORY_FUNCTION "
            "'${_function}' is not a qualified C++ function name.")
    endif()
    set(${out_function} "${_function}" PARENT_SCOPE)
    set(${out_header} "${_header}" PARENT_SCOPE)
endfunction()

# Give every processor-constructing target of `target` the UI package's hook.
function(_pulp_attach_ui_package target ui)
    _pulp_resolve_ui_package("pulp_add_plugin(${target})" "${ui}" _function _header)
    if(NOT _function)
        return()
    endif()

    set(_source "${CMAKE_CURRENT_BINARY_DIR}/pulp_editor_package/${target}.cpp")
    file(CONFIGURE OUTPUT "${_source}" CONTENT
"// Generated by Pulp for ${target}: the default editor of UI package ${ui}.
#include <pulp/format/editor_package.hpp>
#include <${_header}>

namespace {

::pulp::format::EditorFactory* pulp_plugin_editor_factory_hook() {
    return ${_function}();
}

struct PulpPluginEditorFactoryRegistrar {
    PulpPluginEditorFactoryRegistrar() noexcept {
        ::pulp::format::install_plugin_editor_factory_hook(&pulp_plugin_editor_factory_hook);
    }
} pulp_plugin_editor_factory_registrar;

} // namespace
" @ONLY)

    foreach(_suffix IN LISTS _PULP_UI_PACKAGE_TARGET_SUFFIXES)
        set(_format_target "${target}_${_suffix}")
        if(TARGET "${_format_target}")
            target_sources("${_format_target}" PRIVATE "${_source}")
            target_link_libraries("${_format_target}" PRIVATE "${ui}")
            set_property(TARGET "${_format_target}" PROPERTY PULP_UI_PACKAGE "${ui}")
        endif()
    endforeach()
    _pulp_warn_ui_package_formats("${target}" "${ui}")
endfunction()
