{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulp.audio/schemas/importer-differential-benchmark-v1.schema.json",
  "title": "Pulp importer differential benchmark v1",
  "type": "object",
  "required": ["schema", "version", "runs", "cold", "warm", "provenance", "run_receipts"],
  "properties": {
    "schema": {"const": "pulp-importer-differential-benchmark-v1"},
    "version": {"const": 1},
    "runs": {"type": "integer", "minimum": 1},
    "provenance": {"type": "object"},
    "run_receipts": {"type": "array", "minItems": 1},
    "cold": {"$ref": "#/$defs/cacheBucket"},
    "warm": {"$ref": "#/$defs/cacheBucket"},
    "first_invocation": {"type": "object"},
    "repeat_runs": {"type": "object"}
  },
  "$defs": {
    "cacheBucket": {
      "type": "object",
      "oneOf": [
        {
          "required": ["status", "cache_state", "browser_import_p50_ms", "browser_import_p95_ms", "native_total_p50_ms", "native_total_p95_ms", "p50_ms_saved"],
          "properties": {
            "status": {"const": "measured"},
            "cache_state": {"enum": ["cold", "warm"]},
            "browser_import_p50_ms": {"type": "number"},
            "browser_import_p95_ms": {"type": "number"},
            "native_total_p50_ms": {"type": "number"},
            "native_total_p95_ms": {"type": "number"},
            "p50_ms_saved": {"type": "number"}
          }
        },
        {
          "required": ["status", "cache_state", "reason"],
          "properties": {
            "status": {"const": "unverified"},
            "cache_state": {"enum": ["cold", "warm", "unknown"]},
            "reason": {"type": "string"}
          }
        },
        {
          "not": {"required": ["status"]},
          "required": ["browser_import_p50_ms", "browser_import_p95_ms", "native_total_p50_ms", "native_total_p95_ms", "p50_ms_saved"]
        }
      ]
    }
  }
}
