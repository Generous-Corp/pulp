{
  "schema": "pulp-importer-root-causes-v1",
  "version": 1,
  "causes": [
    "source-recognition",
    "javascript-evaluation",
    "conditional-rendering",
    "async-initialization",
    "css-selector",
    "css-specificity",
    "css-inheritance",
    "css-variable",
    "tailwind-resolution",
    "responsive-style",
    "pseudo-element",
    "flex-layout",
    "grid-layout",
    "intrinsic-sizing",
    "absolute-positioning",
    "stacking-context",
    "overflow-clipping",
    "font-resolution",
    "font-metrics",
    "text-wrapping",
    "svg",
    "image-loading",
    "gradient",
    "shadow",
    "filter",
    "transform",
    "animation",
    "portal",
    "canvas",
    "webgl",
    "unsupported-browser-api",
    "unknown"
  ]
}
