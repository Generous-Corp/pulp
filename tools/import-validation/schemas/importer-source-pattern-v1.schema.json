{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulp.audio/schemas/importer-source-pattern-v1.schema.json",
  "title": "Pulp importer source pattern v1",
  "type": "object",
  "required": ["schema", "version", "pattern_id", "source_shape", "provenance", "frequency", "success_rate", "confidence", "known_exceptions"],
  "properties": {
    "schema": {"const": "pulp-importer-source-pattern-v1"},
    "version": {"const": 1},
    "pattern_id": {"type": "string", "minLength": 1},
    "source_shape": {
      "type": "object",
      "properties": {
        "ast_template": {"type": "object"},
        "component_signature": {"type": "object"},
        "dependency_signature": {"type": "array"},
        "tailwind_utility_groups": {"type": "array"},
        "dom_shape_signature": {"type": "object"},
        "computed_style_signature": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["framework", "packages"],
      "properties": {
        "framework": {"type": "string"},
        "packages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "browser_design_ir_template": {"type": ["object", "null"]},
    "candidate_design_ir_template": {"type": ["object", "null"]},
    "frequency": {"type": "integer", "minimum": 0},
    "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "known_exceptions": {"type": "array", "items": {"type": "string"}}
  }
}
