<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Container .app entitlements, notarization-friendly. Filled per build by
     tools/cmake/PulpAuv3Entitlements.cmake: allow-jit only when the host may
     open an editor backed by a JIT JS engine (PULP_JS_ENGINE=v8 or jsc), and
     disable-library-validation only when PULP_AUV3_DISABLE_LIBRARY_VALIDATION
     is ON because the embedded framework or appex is not signed with the
     host's own Team ID. -->
<plist version="1.0">
<dict>
@PULP_AUV3_JIT_ENTITLEMENTS@@PULP_AUV3_LIBRARY_VALIDATION_ENTITLEMENT@</dict>
</plist>
