#pragma once

#include <pulp/format/processor.hpp>
#include <algorithm>

// {{PLUGIN_NAME}} — {{DESCRIPTION}}

namespace {{NAMESPACE}} {

inline pulp::format::PluginDescriptor make_descriptor() {
    return {
        .name = "{{PLUGIN_NAME}}",
        .manufacturer = "{{MANUFACTURER}}",
        .bundle_id = "{{BUNDLE_ID}}",
        .version = "{{VERSION}}",
        .category = pulp::format::PluginCategory::Effect,
    };
}

class {{CLASS_NAME}} : public pulp::format::Processor {
public:
    pulp::format::PluginDescriptor descriptor() const override {
        return make_descriptor();
    }

    void define_parameters(pulp::state::StateStore& /*store*/) override {}

    void prepare(const pulp::format::PrepareContext& /*ctx*/) override {}

    void process(
        pulp::audio::BufferView<float>& output,
        const pulp::audio::BufferView<const float>& input,
        pulp::midi::MidiBuffer& /*midi_in*/,
        pulp::midi::MidiBuffer& /*midi_out*/,
        const pulp::format::ProcessContext& /*ctx*/) override
    {
        // Pass-through — replace with your processing
        const std::size_t n = output.num_samples();
        const std::size_t channels = std::min(output.num_channels(), input.num_channels());
        for (std::size_t ch = 0; ch < channels; ++ch) {
            const float* in = input.channel_ptr(ch);
            float* out = output.channel_ptr(ch);
            if (out != in) std::copy_n(in, n, out);
        }
        // Output channels with no matching input channel are silenced rather
        // than left holding whatever the host's buffer contained.
        for (std::size_t ch = channels; ch < output.num_channels(); ++ch)
            std::fill_n(output.channel_ptr(ch), n, 0.0f);
    }
};

inline std::unique_ptr<pulp::format::Processor> create_{{FACTORY_NAME}}() {
    return std::make_unique<{{CLASS_NAME}}>();
}

} // namespace {{NAMESPACE}}
