#pragma once

#include <pulp/format/processor.hpp>

#include <cstdint>
#include <memory>
#include <optional>

// {{PLUGIN_NAME}} — {{DESCRIPTION}}
//
// A one-voice sine synth that agents can drive through the capability broker.
// It is small on purpose: the agent operations in agent_operations.cpp are the
// interesting part. Replace the voice with your own instrument.

namespace {{NAMESPACE}} {

enum ParamIDs : pulp::state::ParamID {
    kLevel = 1,
    kDetune = 2,
};

inline pulp::format::PluginDescriptor make_descriptor() {
    return {
        .name = "{{PLUGIN_NAME}}",
        .manufacturer = "{{MANUFACTURER}}",
        .bundle_id = "{{BUNDLE_ID}}",
        .version = "{{VERSION}}",
        .category = pulp::format::PluginCategory::Instrument,
        .input_buses = {},
        .output_buses = {{"Out", 2, false}},
        .accepts_midi = true,
    };
}

// The newest held note plays at kLevel, offset by kDetune semitones.
class {{CLASS_NAME}} : public pulp::format::Processor {
public:
    pulp::format::PluginDescriptor descriptor() const override {
        return make_descriptor();
    }

    void define_parameters(pulp::state::StateStore& store) override {
        store.add_parameter({
            .id = kLevel,
            .name = "Level",
            .range = {0.0f, 1.0f, 0.5f},
        });
        store.add_parameter({
            .id = kDetune,
            .name = "Detune",
            .unit = "st",
            .range = {-12.0f, 12.0f, 0.0f},
        });
    }

    void prepare(const pulp::format::PrepareContext& ctx) override {
        sample_rate_ = ctx.sample_rate;
        phase_ = 0.0;
        note_.reset();
        // Resolve parameter handles once, off the audio thread.
        level_ = state().param_reader(kLevel);
        detune_ = state().param_reader(kDetune);
    }

    void process(
        pulp::audio::BufferView<float>& output,
        const pulp::audio::BufferView<const float>& input,
        pulp::midi::MidiBuffer& midi_in,
        pulp::midi::MidiBuffer& midi_out,
        const pulp::format::ProcessContext& ctx) override;  // defined in {{SOURCE_NAME}}

private:
    double sample_rate_ = 48000.0;
    double phase_ = 0.0;
    std::optional<std::uint8_t> note_;
    pulp::state::ParamReader level_;
    pulp::state::ParamReader detune_;
};

inline std::unique_ptr<pulp::format::Processor> create_{{FACTORY_NAME}}() {
    return std::make_unique<{{CLASS_NAME}}>();
}

} // namespace {{NAMESPACE}}

// The controlled build (CONTROL_CAPABILITIES in CMakeLists.txt) launches a
// separate host and renders offline previews from this global factory.
std::unique_ptr<pulp::format::Processor> create_{{LOWER_NAME}}();
