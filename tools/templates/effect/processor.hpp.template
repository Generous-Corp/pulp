#pragma once

#include <pulp/audio/buffer_ops.hpp>
#include <pulp/format/processor.hpp>
#include <algorithm>
#include <cmath>

// {{PLUGIN_NAME}} — {{DESCRIPTION}}

namespace {{NAMESPACE}} {

enum ParamIDs : pulp::state::ParamID {
    kMix = 1,
};

inline pulp::format::PluginDescriptor make_descriptor() {
    return {
        .name = "{{PLUGIN_NAME}}",
        .manufacturer = "{{MANUFACTURER}}",
        .bundle_id = "{{BUNDLE_ID}}",
        .version = "{{VERSION}}",
        .category = pulp::format::PluginCategory::Effect,
    };
}

class {{CLASS_NAME}} : public pulp::format::Processor {
public:
    // Reads its parameters once per block, so it opts out of per-point
    // automation: the VST3, AU v2 and CLAP adapters then write each
    // automated parameter once per block and dense automation costs nothing.
    bool wants_sample_accurate_parameters() const override { return false; }

    pulp::format::PluginDescriptor descriptor() const override {
        return make_descriptor();
    }

    void define_parameters(pulp::state::StateStore& store) override {
        store.add_parameter({
            .id = kMix,
            .name = "Mix",
            .unit = "%",
            .range = {0.0f, 100.0f, 100.0f},
        });
    }

    void prepare(const pulp::format::PrepareContext& ctx) override {
        sample_rate_ = ctx.sample_rate;
        // Resolve parameter handles once, off the audio thread; reading one
        // in process() is a single atomic load with no ID lookup.
        mix_ = state().param_reader(kMix);
    }

    void process(
        pulp::audio::BufferView<float>& output,
        const pulp::audio::BufferView<const float>& input,
        pulp::midi::MidiBuffer& /*midi_in*/,
        pulp::midi::MidiBuffer& /*midi_out*/,
        const pulp::format::ProcessContext& /*ctx*/) override
    {
        const float mix = mix_.get() / 100.0f;

        // Take each channel's raw pointers once, outside the sample loop.
        // map_samples() runs the per-sample function in order and vectorizes
        // whether the host hands us separate buffers or processes in place.
        // An effect that needs neighbouring samples or per-channel state can
        // loop over the two pointers itself instead.
        const std::size_t n = output.num_samples();
        const std::size_t channels = std::min(output.num_channels(), input.num_channels());
        for (std::size_t ch = 0; ch < channels; ++ch) {
            pulp::audio::buffer_ops::map_samples(
                input.channel_ptr(ch), output.channel_ptr(ch), n, [mix](float dry) {
                    const float wet = dry; // TODO: replace with your effect processing
                    return dry * (1.0f - mix) + wet * mix;
                });
        }
        // Output channels with no matching input channel are silenced rather
        // than left holding whatever the host's buffer contained.
        for (std::size_t ch = channels; ch < output.num_channels(); ++ch)
            std::fill_n(output.channel_ptr(ch), n, 0.0f);
    }

private:
    double sample_rate_ = 48000.0;
    pulp::state::ParamReader mix_;
};

inline std::unique_ptr<pulp::format::Processor> create_{{FACTORY_NAME}}() {
    return std::make_unique<{{CLASS_NAME}}>();
}

} // namespace {{NAMESPACE}}
