cmake_minimum_required(VERSION 3.24)
project({{TARGET_NAME}} VERSION {{VERSION}} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

find_package(Pulp {{SDK_VERSION}} REQUIRED)

# Tests
include(FetchContent)
# Populate dependencies in this configure rather than in a nested sub-build.
if(POLICY CMP0168)
    cmake_policy(SET CMP0168 NEW)
endif()
# An installed Catch2 3.7.1 or newer 3.x (for example `brew install catch2`) is used as-is, which
# skips both the download and compiling its ~100 sources. Otherwise the pinned
# release archive is fetched and checked against its hash, which is quicker
# than a git clone of the whole history.
FetchContent_Declare(Catch2
    URL https://github.com/catchorg/Catch2/archive/refs/tags/v3.16.1.tar.gz
    URL_HASH SHA256=d16bd1b8b2364918bd472cb216394acb93bde6784890df0d91bccfb3f28d777d
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    FIND_PACKAGE_ARGS 3.16.1 CONFIG
)
FetchContent_MakeAvailable(Catch2)
include(CTest)
if(catch2_SOURCE_DIR)
    list(APPEND CMAKE_MODULE_PATH ${catch2_SOURCE_DIR}/extras)
endif()
include(Catch)

add_executable({{TARGET_NAME}}-test test_{{LOWER_NAME}}.cpp)
target_link_libraries({{TARGET_NAME}}-test PRIVATE Pulp::format Catch2::Catch2WithMain)
target_include_directories({{TARGET_NAME}}-test PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
catch_discover_tests({{TARGET_NAME}}-test)

pulp_add_plugin({{TARGET_NAME}}
    FORMATS         {{FORMATS}}
    PLUGIN_NAME     "{{PLUGIN_NAME}}"
    BUNDLE_ID       "{{BUNDLE_ID}}"
    MANUFACTURER    "{{MANUFACTURER}}"
    VERSION         "{{VERSION}}"
    CATEGORY        Instrument
    PLUGIN_CODE     "{{PLUGIN_CODE}}"
    MANUFACTURER_CODE "{{MANUFACTURER_CODE}}"
    AAX_PRODUCT_CODE "{{AAX_PRODUCT_CODE}}"
    AAX_NATIVE_CODE "{{AAX_NATIVE_CODE}}"
)

