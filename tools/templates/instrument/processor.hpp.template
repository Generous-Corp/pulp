#pragma once

#include <pulp/format/processor.hpp>
#include <pulp/signal/oscillator.hpp>
#include <pulp/signal/adsr.hpp>
#include <cmath>

// {{PLUGIN_NAME}} — {{DESCRIPTION}}

namespace {{NAMESPACE}} {

enum ParamIDs : pulp::state::ParamID {
    kGain = 1,
};

inline pulp::format::PluginDescriptor make_descriptor() {
    return {
        .name = "{{PLUGIN_NAME}}",
        .manufacturer = "{{MANUFACTURER}}",
        .bundle_id = "{{BUNDLE_ID}}",
        .version = "{{VERSION}}",
        .category = pulp::format::PluginCategory::Instrument,
        .input_buses = {},
        .output_buses = {{"Main Out", 2, false}},
        .accepts_midi = true,
    };
}

class {{CLASS_NAME}} : public pulp::format::Processor {
public:
    // Reads its parameters once per block, so it opts out of per-point
    // automation: the VST3, AU v2 and CLAP adapters then write each
    // automated parameter once per block and dense automation costs nothing.
    bool wants_sample_accurate_parameters() const override { return false; }

    pulp::format::PluginDescriptor descriptor() const override {
        return make_descriptor();
    }

    void define_parameters(pulp::state::StateStore& store) override {
        store.add_parameter({
            .id = kGain,
            .name = "Gain",
            .unit = "dB",
            .range = {-60.0f, 12.0f, 0.0f},
        });
    }

    void prepare(const pulp::format::PrepareContext& ctx) override {
        osc_.set_sample_rate(static_cast<float>(ctx.sample_rate));
        env_.set_sample_rate(static_cast<float>(ctx.sample_rate));
        env_.set_params({0.01f, 0.1f, 0.7f, 0.3f});
        // Resolve parameter handles once, off the audio thread; reading one
        // in process() is a single atomic load with no ID lookup.
        gain_db_ = state().param_reader(kGain);
    }

    void process(
        pulp::audio::BufferView<float>& output,
        const pulp::audio::BufferView<const float>& input,
        pulp::midi::MidiBuffer& midi_in,
        pulp::midi::MidiBuffer& midi_out,
        const pulp::format::ProcessContext& ctx) override;  // defined in {{SOURCE_NAME}}

private:
    pulp::state::ParamReader gain_db_;
    pulp::signal::Oscillator osc_;
    pulp::signal::Adsr env_;
};

inline std::unique_ptr<pulp::format::Processor> create_{{FACTORY_NAME}}() {
    return std::make_unique<{{CLASS_NAME}}>();
}

} // namespace {{NAMESPACE}}
