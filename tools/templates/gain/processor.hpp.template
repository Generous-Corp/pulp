#pragma once

#include <pulp/format/processor.hpp>
#include <pulp/view/value_channel_set.hpp>
#include <pulp/view/value_source.hpp>
#include <algorithm>
#include <cmath>

// {{PLUGIN_NAME}} — Stereo gain plugin with bypass

namespace {{NAMESPACE}} {

enum ParamIDs : pulp::state::ParamID {
    kGain   = 1,
    kBypass = 2,
};

inline pulp::format::PluginDescriptor make_descriptor() {
    return {
        .name = "{{PLUGIN_NAME}}",
        .manufacturer = "{{MANUFACTURER}}",
        .bundle_id = "{{BUNDLE_ID}}",
        .version = "{{VERSION}}",
        .category = pulp::format::PluginCategory::Effect,
    };
}

class {{CLASS_NAME}} : public pulp::format::Processor {
public:
    {{CLASS_NAME}}() {
        // Live data the UI shows but a DAW should not automate is a value
        // channel, not a parameter. ui/main.js binds it with bindMeter(), so
        // the meter updates natively each frame with no JavaScript per tick.
        output_meter_ = channels_.declare_meter("output");
    }

    pulp::view::ValueChannelSet* value_channels() override { return &channels_; }

    pulp::format::PluginDescriptor descriptor() const override {
        return make_descriptor();
    }

    void define_parameters(pulp::state::StateStore& store) override {
        store.add_parameter({
            .id = kGain,
            .name = "Gain",
            .unit = "dB",
            .range = {-60.0f, 24.0f, 0.0f, 0.1f},
        });
        store.add_parameter({
            .id = kBypass,
            .name = "Bypass",
            .unit = "",
            .range = {0.0f, 1.0f, 0.0f, 1.0f},
        });
    }

    void prepare(const pulp::format::PrepareContext&) override {}

    void process(
        pulp::audio::BufferView<float>& output,
        const pulp::audio::BufferView<const float>& input,
        pulp::midi::MidiBuffer& /*midi_in*/,
        pulp::midi::MidiBuffer& /*midi_out*/,
        const pulp::format::ProcessContext& /*ctx*/) override
    {
        const bool bypassed = state().get_value(kBypass) >= 0.5f;
        const float gain = bypassed ? 1.0f
                                    : std::pow(10.0f, state().get_value(kGain) / 20.0f);

        for (std::size_t ch = 0; ch < output.num_channels() && ch < input.num_channels(); ++ch)
            for (std::size_t i = 0; i < output.num_samples(); ++i)
                output.channel(ch)[i] = input.channel(ch)[i] * gain;

        publish_output_level(output);
    }

    // ── Custom editor (optional) ─────────────────────────────────────────
    //
    // Leave this alone to get the default scripted / AutoUi editor built
    // from the parameters you registered above. Every plugin format
    // (VST3, AU v2, AU v3, CLAP, Standalone) will open it through a
    // `pulp::format::ViewBridge` — lifecycle callbacks below are wired
    // automatically.
    //
    // Override `create_view()` to return your own `view::View` tree, and
    // `view_size()` to publish min/max/preferred bounds for host-side
    // resize. See docs/guides/view-bridge.md for the full pattern.
    //
    // Ink & Signal is Pulp's default design language for new apps. Adopt it by
    // setting the theme on your root and opting widgets into the navigation
    // variants — existing apps that do neither are unaffected:
    //
    //   #include <pulp/design/design_system.hpp>   // ink_signal_theme()
    //
    //   std::unique_ptr<pulp::view::View> create_view() override {
    //       auto root = std::make_unique<pulp::view::View>();
    //       root->set_theme(pulp::design::ink_signal_theme(/*dark=*/true));
    //       auto tabs = std::make_unique<pulp::view::TabPanel>();
    //       tabs->set_tab_bar_style(pulp::view::TabPanel::TabBarStyle::underline);
    //       // … add tabs / a SegmentedControl / an accent ListBox nav …
    //       root->add_child(std::move(tabs));
    //       return root;
    //   }
    //
    // Without a theme, widgets fall back to Ink & Signal-flavoured defaults; set
    // the theme to get the full token set and to let users restyle via a theme.
    //
    // std::unique_ptr<pulp::view::View> create_view() override {
    //     auto root = std::make_unique<pulp::view::View>();
    //     // build your custom widget hierarchy here …
    //     return root;
    // }
    //
    // pulp::format::ViewSize view_size() const override {
    //     return {/*preferred_w*/ 640, /*preferred_h*/ 480,
    //             /*min_w*/       400, /*min_h*/       300,
    //             /*max_w*/      1280, /*max_h*/       960};
    // }
    //
    // void on_view_opened (pulp::view::View&)                     override {}
    // void on_view_closed (pulp::view::View&)                     override {}
    // void on_view_resized(pulp::view::View&, uint32_t, uint32_t) override {}
    //
    // Keep a scripted editor fast by construction (the view-bridge skill's
    // "Realtime scripted editors" checklist has the reasons and measurements):
    //   * meters and levels: a value channel + bindMeter(), as above;
    //   * any other per-tick data (analyzer frames, modulation): push it with
    //     WidgetBridge::dispatch_native_message(receiver, type, payload), never
    //     load_script(), and have the receiver draw directly;
    //   * a spectrum polling VisualizationBridge: set
    //     VisualizationConfig::backlog_policy =
    //     VisualizationBacklogPolicy::latest_window.

private:
    // Audio thread: one peak/RMS reading per block. publish() is lock-free and
    // allocation-free.
    void publish_output_level(const pulp::audio::BufferView<float>& output) {
        if (output_meter_ == nullptr) return;
        pulp::view::MeterFrame frame;
        frame.channels = static_cast<int>(std::min<std::size_t>(
            output.num_channels(), pulp::view::MeterFrame::kMaxChannels));
        for (int ch = 0; ch < frame.channels; ++ch) {
            float peak = 0.0f;
            float sum = 0.0f;
            const auto samples = output.channel(static_cast<std::size_t>(ch));
            for (std::size_t i = 0; i < output.num_samples(); ++i) {
                peak = std::max(peak, std::abs(samples[i]));
                sum += samples[i] * samples[i];
            }
            frame.peak[ch] = peak;
            frame.rms[ch] = output.num_samples() > 0
                ? std::sqrt(sum / static_cast<float>(output.num_samples()))
                : 0.0f;
        }
        output_meter_->publish(frame);
    }

    pulp::view::ValueChannelSet channels_;
    pulp::view::MeterSource* output_meter_ = nullptr;
};

inline std::unique_ptr<pulp::format::Processor> create_{{FACTORY_NAME}}() {
    return std::make_unique<{{CLASS_NAME}}>();
}

} // namespace {{NAMESPACE}}
