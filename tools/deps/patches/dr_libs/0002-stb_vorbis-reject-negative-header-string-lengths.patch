       len = get32_packet(f);
+      if (len < 0 || len > PULP_VORBIS_MAX_COMMENT_LENGTH) return error(f, VORBIS_invalid_setup);
       f->comment_list[i] = (char*)setup_malloc(f, sizeof(char) * (len+1));
