[Unit]
Description=Pulp trusted ephemeral CI runner slot %i (golden clone, one job, destroy)
Documentation=planning/2026-07-30-macpro-proxmox-ci-handoff.md
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=simple
# Shared root-owned credential and controller paths. The unit's fixed profile
# settings below deliberately override any legacy profile values in this file.
EnvironmentFile=-/etc/pulp/linux-runner-group.env
Environment=PULP_LINUX_RUNNER_GROUP_ID=3
Environment=PULP_LINUX_RUNNER_GROUP_PROFILE=trusted
Environment=PULP_RUNNER_NAME_PREFIX=pulp-auto-ephemeral
# One job per invocation: the runner is --ephemeral, so run.sh exits when the job
# completes and the clone is destroyed on the way out. systemd restarts us, which
# provisions a fresh clone for the next job. That loop IS the pool.
ExecStart=/usr/local/sbin/pulp-ephemeral-runner.sh
Restart=always
# 30s between jobs: long enough that a persistent failure (bad golden, revoked
# PAT) backs off visibly in the journal instead of spinning, short enough that a
# queued job waits seconds rather than minutes.
RestartSec=30
# Exit 75 is the governor refusing admission — not a fault. Back off longer and
# retry rather than restarting into the same refusal.
RestartPreventExitStatus=
TimeoutStopSec=180
User=root

[Install]
WantedBy=multi-user.target
