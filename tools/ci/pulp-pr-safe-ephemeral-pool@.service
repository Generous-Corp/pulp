[Unit]
Description=Pulp PR-safe ephemeral CI runner slot %i (golden clone, one job, destroy)
Documentation=docs/guides/local-ci.md
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=simple
# Reuse only root-owned credential and controller paths. The profile wrapper
# exports its identity after systemd constructs this environment, so legacy
# identity values cannot move a PR-safe slot into the trusted pool.
EnvironmentFile=-/etc/pulp/linux-runner-group.env
ExecStart=/usr/local/sbin/proxmox-pr-safe-ephemeral-runner-linux.sh
Restart=always
RestartSec=30
RestartPreventExitStatus=
TimeoutStopSec=180
User=root

[Install]
WantedBy=multi-user.target
