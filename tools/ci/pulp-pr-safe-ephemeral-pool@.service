[Unit]
Description=Pulp PR-safe ephemeral CI runner slot %i (golden clone, one job, destroy)
Documentation=docs/guides/local-ci.md
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=simple
# Reuse only root-owned credential and controller paths. These fixed settings
# keep PR-safe slots out of the trusted group and runner-name namespace.
EnvironmentFile=-/etc/pulp/linux-runner-group.env
Environment=PULP_LINUX_RUNNER_GROUP_ID=5
Environment=PULP_LINUX_RUNNER_GROUP_PROFILE=pr-safe
Environment=PULP_RUNNER_NAME_PREFIX=pulp-pr-safe-ephemeral
ExecStart=/usr/local/sbin/pulp-ephemeral-runner.sh
Restart=always
RestartSec=30
RestartPreventExitStatus=
TimeoutStopSec=180
User=root

[Install]
WantedBy=multi-user.target
