[Unit]
Description=Pulp PR-safe ephemeral Linux CI runner slot %i
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pulp/linux-pr-safe-runner-group.env
ExecStart=/usr/local/sbin/pulp-pr-safe-ephemeral-runner.sh
Restart=always
RestartSec=30
RestartPreventExitStatus=
TimeoutStopSec=180
User=root

[Install]
WantedBy=multi-user.target
