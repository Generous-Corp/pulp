# Profile for pulp-ephemeral-pool@preamble.service: a dedicated, tiny slot that
# runs only the seconds-long preamble jobs (resolve-provider, classify,
# protected-receipt-reuse). It carries its own label and none of the build
# labels, so a long Linux build can never take it and a preamble job never
# queues behind one. Installed as /etc/pulp/linux-runner-group-preamble.env.
#
# Repository scope, like the generic slot: an explicit empty group id.
PULP_LINUX_RUNNER_GROUP_ID=
TARTCI_RUNNER_LABELS=self-hosted,Linux,X64,pulp-preamble-macpro
TARTCI_RUNNER_NAME_PREFIX=pulp-preamble-ephemeral
# VMID 203, outside the build slots' 200..202 and inside the reaper's range.
TARTCI_PROXMOX_CLONE_BASE=203
TARTCI_PROXMOX_CLONE_MAX=203
# Index the LAN identity from the build slots' base: 203 -> 192.168.86.254.
TARTCI_PROXMOX_GUEST_INDEX_BASE=200
TARTCI_PROXMOX_CORES=1
TARTCI_PROXMOX_MEMORY_MB=2048
