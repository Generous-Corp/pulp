[Unit]
Description=Pulp Windows x64 CI runner slot %i (golden snapshot, one job, reset)
Documentation=https://github.com/Generous-Corp/pulp/blob/main/docs/guides/local-ci.md
After=network-online.target pve-guests.service
Wants=network-online.target
# Same restart ceiling as the Linux pool: a slot that fails 40 times in an hour
# stops and stays failed where `systemctl --failed` and the host health check
# report it. Governor refusals do not count toward it; the supervisor waits
# about five minutes per refusal.
StartLimitIntervalSec=3600
StartLimitBurst=40

[Service]
Type=simple
# Names the VM and golden snapshot this slot owns. Required.
EnvironmentFile=/etc/pulp/windows-runner-%i.env
# One job per invocation: the runner is a JIT (single-job) registration, and the
# VM is rolled back to the golden snapshot on the way out. systemd restarts us
# for the next job. That loop is the pool.
ExecStart=/usr/local/sbin/pulp-windows-ephemeral-runner.sh
Restart=always
RestartSec=30
# On stop, the supervisor lets a running job finish (up to its 4800 s busy
# wait), then shuts the VM down and rolls it back. The timeout covers all of
# that, so systemd never SIGKILLs a draining job; a kill would leave the VM
# running and the next start would have to wait the job out.
TimeoutStopSec=5400
User=root

[Install]
WantedBy=multi-user.target
