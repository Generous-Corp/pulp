--- a/src/chrome.cpp
+++ b/src/chrome.cpp
@@ -6997,15 +6997,25 @@
     // needs no run loop, and so behaves the same in a headless test as in the
     // app -- which a "defer to the next turn of the loop" fix would not.
     // NOT cleared here. Freeing the PREVIOUS generation at the start of the
-    // next reset moved the crash from the first build to the second: something
-    // in the chrome still refers to a retired bubble, and this is not the
-    // place to find out what. They are held for the life of the editor
-    // instead -- a few dozen detached labels per session, against a
-    // reproducible segfault on the app's primary button.
+    // next reset moved the crash from the first build to the second, and the
+    // reference that outlived a retired view was the SHELL's: a product's chat
+    // accessory is a child of this column, so retiring it handed the shell's
+    // own `explanation_` / `module_summary_` to this list -- which
+    // `~ForgeChrome` frees while the shell is still live. They are held for the
+    // life of the editor instead -- a few dozen detached labels per session,
+    // against a reproducible segfault on the app's primary button.
     if (chat_col_) {
         for (std::size_t i = chat_col_->child_count(); i-- > 0;) {
             pulp::view::View* c = chat_col_->child_at(i);
             if (c == status_card_) continue;  // keep the reusable status card
+            // The product's own accessory is not part of the conversation. It
+            // shows the ARTIFACT -- Forge Modular's patch explanation and
+            // module spec -- so a reset that drops the previous build's chat
+            // must leave it in the rail. Retiring it detached it permanently
+            // (the accessory hook runs once, when the chrome mounts), so from
+            // the first build onward the explanation could never be shown
+            // again, and its owner became this chrome rather than the tree.
+            if (c == chat_accessory_) continue;
             if (auto owned = chat_col_->remove_child(c))
                 retired_chat_.push_back(std::move(owned));
         }
