+
+void ForgeChrome::set_active_stage_elapsed(const std::string& text) {
+    if (active_chip_ < 0 || active_chip_ >= static_cast<int>(chips_.size())) return;
+    Chip& c = chips_[static_cast<std::size_t>(active_chip_)];
+    if (c.state && c.state->text() != text) {
+        c.state->set_text(text);
+        if (root_) root_->request_repaint();
+    }
+}
+
+void ForgeChrome::set_active_stage(int index) {
+    if (index < 0) {
+        active_chip_ = -1;
+        for (auto& c : chips_) {
+            if (c.dot) c.dot->set_background_color(kLine);
+            if (c.title) c.title->set_text_color(kMuted);
+            if (c.state) c.state->set_text({});
+        }
+    } else if (index < static_cast<int>(chips_.size())) {
+        for (int k = 0; k < index; ++k) {
+            Chip& done = chips_[static_cast<std::size_t>(k)];
+            if (done.dot) done.dot->set_background_color(kAccentDim);
+            if (done.title) done.title->set_text_color(kText);
+            if (done.state) done.state->set_text("ok");
+        }
+        Chip& c = chips_[static_cast<std::size_t>(index)];
+        if (c.dot) c.dot->set_background_color(kAccent);
+        if (c.title) c.title->set_text_color(kTextStrong);
+        if (c.state) c.state->set_text({});
+        active_chip_ = index;
+    }
+    if (root_) root_->request_repaint();
+}
