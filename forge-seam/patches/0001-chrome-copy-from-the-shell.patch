--- a/include/forge/shell.hpp
+++ b/include/forge/shell.hpp
@@ -59,6 +59,23 @@ class ProjectStore;
 // re-bake into an effect shell), and used to select the generation vocabulary.
 enum class ShellKind { effect, instrument, midi_effect };
 
+/// The product-facing words the chrome shows.
+///
+/// These used to be four `switch (kind)` functions inside chrome.cpp, which put
+/// product copy in the layout code and meant a new product could not supply its
+/// own without editing the chrome. Each shell answers for itself now; the chrome
+/// asks rather than decides.
+struct ChromeCopy {
+    /// The title-bar badge — "FORGE INST", "FORGE MIDI", "FORGE FX".
+    std::string badge;
+    /// What the empty composer suggests.
+    std::string prompt_placeholder;
+    /// What the composer suggests once something has been built.
+    std::string followup_placeholder;
+    /// The name of the build a fresh install opens with.
+    std::string default_build_title;
+};
+
 const char* shell_kind_name(ShellKind kind);        // "effect" / "instrument" / "midi_effect"
 ShellKind shell_kind_from_name(const std::string& name, ShellKind fallback);
 
@@ -343,6 +360,12 @@ public:
     // ── Kind-specific hooks each concrete shell fills in ─────────────────────
 
     // Whether a build is installed and processing.
+    /// The words this product shows in the chrome.
+    ///
+    /// Pure virtual on purpose: a new product that forgets to answer will not
+    /// compile, rather than silently inheriting another product's copy.
+    virtual ChromeCopy chrome_copy() const = 0;
+
     virtual bool has_build() const = 0;
 
     // One descriptor per bound macro of the ACTIVE build, current values.
