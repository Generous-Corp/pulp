-const char* default_build_title(ShellKind kind) {
-    switch (kind) {
-        case ShellKind::instrument: return "Subtractive Synth";
-        case ShellKind::midi_effect: return "Note Pass";
-        case ShellKind::effect: break;
+// Product copy comes from the shell, which answers for itself. These four used
+// to switch on ShellKind here, which put product words in the layout code and
+// meant a new product could not supply its own without editing this file.
+//
+// std::string rather than const char*: the copy lives in a value the shell
+// returns, so handing back a pointer into a temporary would dangle.
+/// Build one composer action from its description.
+///
+/// The chrome owns the treatment -- size, radius, border, icon colour -- so a
+/// product describing a row cannot accidentally style itself differently from
+/// its siblings. It says what the buttons ARE; this decides how they look.
+std::unique_ptr<TextButton> make_composer_action(const ComposerAction& spec) {
+    auto b = std::make_unique<TextButton>();
+    b->set_style(spec.primary ? TextButton::Style::primary
+                              : TextButton::Style::ghost);
+    b->set_access_label(spec.access_label.empty() ? spec.label
+                                                  : spec.access_label);
+    const bool icon_only = spec.label.empty();
+    // Height only for a labelled button: size() sets a preferred WIDTH, and
+    // passing 0 collapsed the button, then its row, then the whole home column
+    // -- the render came back empty with nothing in the log to say why. A
+    // labelled button takes its width from its padding and text.
+    if (icon_only) {
+        size(*b, 34.0f, 34.0f);
+    } else {
+        b->flex().preferred_height = 34.0f;
+    }
+    if (!spec.primary) b->set_border(kLine, 1, design::radius::medium);
+    b->flex().direction = FlexDirection::row;   // default is column: labels wrapped
+    b->flex().align_items = FlexAlign::center;
+    b->flex().justify_content = FlexJustify::center;
+    if (!icon_only) {
+        b->flex().padding_left = 12;
+        b->flex().padding_right = 14;
+        b->flex().gap = 7;
+    }
+
+    const Color ink = spec.primary ? kOnInk : kMuted;
+    switch (spec.icon) {
