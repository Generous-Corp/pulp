+void ForgeChrome::refresh_default_project_title() {
+    // The default title names the ARTIFACT, and the artifact can change after
+    // the title was chosen: starting on Module and switching to Patch left the
+    // heading reading "Untitled module" beside a PATCH pill for the whole
+    // build. Only an untitled project is re-derived -- a title taken from the
+    // user's own prompt is theirs, and switching tabs must not take it away.
+    if (!project_title_is_default_) return;
+    project_title_ = default_build_title(shell_);
+    refresh_shell_chrome();
+    if (root_) root_->request_repaint();
+}
+
+void ForgeChrome::set_project_title_from_prompt(const std::string& prompt) {
+    if (prompt.empty()) return;
+    project_title_ = gen::display_title_from_prompt(prompt);
+    project_title_is_default_ = false;   // a real name; never overwrite it
+    // refresh_shell_chrome(), not refresh_copy(): the title bar's label is
+    // painted there, and refreshing only the copy left the heading reading
+    // "Untitled module" for the whole build.
+    refresh_shell_chrome();
+    if (root_) root_->request_repaint();
+}
+
+void ForgeChrome::refresh_composer_row() {
+    // Rebuild the described row from the shell. It was built once, so a
+    // product whose row depends on state -- Forge Modular's Build button says
+    // "module" or "patch" -- kept the label it was born with: the Patch tab
+    // selected above a button still offering to build a module.
+    if (!composer_actions_) return;
+    auto described = shell_.composer_row();
+    if (described.left.empty() && described.right.empty()) return;
+
+    while (composer_actions_->child_count() > 0)
+        composer_actions_->remove_child(composer_actions_->child_at(0));
+    for (const auto& a : described.left) {
+        auto b = make_composer_action(a);
+        b->flex().margin_right = 8;
+        composer_actions_->add_child(std::move(b));
+    }
+    composer_actions_->add_child(make_spacer());
+    for (const auto& a : described.right) {
+        auto b = make_composer_action(a);
+        b->flex().margin_left = 8;
+        composer_actions_->add_child(std::move(b));
+    }
+    if (root_) { root_->invalidate_layout(); root_->request_repaint(); }
+}
