+/// One button in the composer's action row.
+///
+/// A description rather than a built widget, so a product can say what its row
+/// contains without the chrome hard-coding it and without the product reaching
+/// into chrome's view types.
+struct ComposerAction {
+    /// Which of chrome's icons to draw. `none` leaves the button text-only.
+    enum class Icon { none, plus, dice, arrow_up, document, search, gear };
+    /// Empty means icon-only, which is how the compact tiles are expressed.
+    std::string label;
+    /// What a screen reader says. Required -- an icon-only button with no label
+    /// is unreachable, and defaulting it to the visible text would leave the
+    /// icon-only cases silent.
+    std::string access_label;
+    Icon icon = Icon::none;
+    /// `primary` is the filled accent treatment; everything else is ghost.
+    bool primary = false;
+    /// Runs on click. A null callback means the button is present but inert,
+    /// which some are before their feature lands.
+    std::function<void()> on_click;
+};
+
+/// The composer's action row: what sits left of the spacer, and what sits right.
+struct ComposerRow {
+    std::vector<ComposerAction> left;
+    std::vector<ComposerAction> right;
+};
+
